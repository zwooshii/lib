local C, Tgt = {}, {}
local TOKENS = { "bg", "side", "group", "border", "text", "dim", "accent" }
local function applyTheme(name, instant)
    for _, t in ipairs(THEMES) do
        if t.name == name then
            for _, k in ipairs(TOKENS) do
                Tgt[k] = t[k]
                if instant or not C[k] then C[k] = t[k] end
            end
        end
    end
end
local function stepTheme()
    local a = 1 - exp(-9 * DT)
    for k, v in pairs(Tgt) do C[k] = mix(C[k], v, a) end
    C.track = mix(C.group, C.text, 0.15)
    C.hover = mix(C.group, C.text, 0.07)
    C.sel = mix(C.group, C.accent, 0.14)
    C.popup = mix(C.bg, C.text, 0.04)
    C.knob = mix(C.text, { 1, 1, 1 }, 0.5)
    C.white = { 1, 1, 1 }
    C.black = { 0, 0, 0 }
end
