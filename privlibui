    Box        = Color3.fromRGB(9, 9, 14),
    Border     = Color3.fromRGB(42, 38, 62),
    Outline    = Color3.fromRGB(88, 60, 150),
    Accent     = Color3.fromRGB(176, 124, 255),
    Text       = Color3.fromRGB(205, 205, 215),
