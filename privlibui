local function drawPopup(hub)
    local p = POP
    if not p then return end
    CLIP0, CLIP1 = nil, nil
    local t = ani(p, "__t", p.closing and 0 or 1, 20)
    if p.closing and t < 0.02 then POP = nil; return end
    local ph = ani(p, "__h", p.measure(p), 18)
    local pxx, pyy = p.x, p.y
    local vw, vh = Camera.ViewportSize.X, Camera.ViewportSize.Y
    if OX + (pxx + p.w) * SCL > vw - 8 then pxx = (vw - 8 - OX) / SCL - p.w end
    if OX + pxx * SCL < 8 then pxx = (8 - OX) / SCL end
    if OY + (pyy + ph) * SCL > vh - 8 then pyy = (vh - 8 - OY) / SCL - ph end
    local save = GA
    GA = save * t
    local yoff = (1 - t) * -6
    Rect(p, "sh", pxx - 1, pyy + yoff + 3, p.w + 2, ph + 2, C.black, 0.35, 200, true, 9)
    Box2(p, "bg", pxx, pyy + yoff, p.w, ph, C.popup, C.border, 1, 201, 8)
    CLIP0, CLIP1 = pyy + yoff + 2, pyy + yoff + ph - 2
    ctxOK = not p.closing
    p.content(p, pxx, pyy + yoff, 204)
    CLIP0, CLIP1 = nil, nil
    if M.pressed and p.born ~= frameId and not p.closing then
        if not (M.x >= pxx and M.x <= pxx + p.w and M.y >= pyy and M.y <= pyy + ph) then p.closing = true end
    end
    GA = save
end

