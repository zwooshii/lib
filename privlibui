--========================================================================
-- Math helpers
--========================================================================
local function clamp(v, a, b) if v < a then return a elseif v > b then return b end return v end
local function lerp(a, b, t) return a + (b - a) * t end
local function rgb(r, g, b) return { r / 255, g / 255, b / 255 } end
local function mix(a, b, t) return { a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t, a[3] + (b[3] - a[3]) * t } end

local NARROW = {}
for ch in (" ijltfrI.,:;|!'[]()"):gmatch(".") do NARROW[ch] = true end
local function tw(s, size)
    local w = 0
    for i = 1, #s do
        local ch, b = s:sub(i, i), s:byte(i)
        if NARROW[ch] then w = w + 0.33
        elseif ch == "m" or ch == "w" or ch == "M" or ch == "W" then w = w + 0.86
        elseif b >= 65 and b <= 90 then w = w + 0.64
        elseif b >= 128 then w = w + 0.3
        else w = w + 0.56 end
    end
    return w * size
end
local function fit(s, maxw, size)
    if tw(s, size) <= maxw then return s end
    while #s > 1 and tw(s .. "...", size) > maxw do s = s:sub(1, #s - 1) end
    return s .. "..."
end
local function wrap(text, maxw, size)
    local lines, line = {}, ""
    for word in text:gmatch("%S+") do
        local t = (line == "") and word or (line .. " " .. word)
        if tw(t, size) > maxw and line ~= "" then lines[#lines + 1] = line; line = word else line = t end
    end
    if line ~= "" then lines[#lines + 1] = line end
    return lines
end

