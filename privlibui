----------------------------------------------------------------------
-- Toggle
----------------------------------------------------------------------
function Section:AddToggle(id, label, default, cb)
    local win = self.win
    local y = self:_grow(18)
    local obj = { id = id, type = "Toggle", value = (default == true), cb = cb, rx = self.box.w - 8 }
    local frame = self:_r("Square", { Filled = true, Color = T.Box, Size = V2(12, 12), ZIndex = 5 }, 8, y + 3)
    local bd = self:_r("Square", { Filled = false, Thickness = 1, Color = T.Border, Size = V2(12, 12), ZIndex = 6 }, 8, y + 3)
    local fill = self:_r("Square", { Filled = true, Color = T.Accent, Size = V2(8, 8), ZIndex = 7 }, 10, y + 5)
    local lbl = self:_r("Text", { Text = U(label), Color = T.Text, Font = FONT, Size = 12, ZIndex = 6 }, 26, y + 3)
    fill.hidden = not obj.value

    function obj:Set(v, silent)
        v = (v == true)
        if v == self.value and fill.hidden == (not v) then return end
        self.value = v
        fill.hidden = not v
        Lib.Flags[id or ""] = v
        win:_sync()
        if self.cb and not silent then pcall(self.cb, v) end
    end
    function obj:Get() return self.value end
    function obj:Export() return self.value end
    function obj:Import(v) if type(v) == "boolean" then self:Set(v) end end
    function obj:AddKeybind(kid, default, mode, kcb)
        local kb, nrx = self.sec:_keybindAt(kid, self.y, self.rx, default, mode, kcb)
        self.rx = nrx
        return kb
    end
    function obj:AddColorPicker(cid, color, ccb)
        local cp, nrx = self.sec:_colorAt(cid, self.y, self.rx, color, ccb)
        self.rx = nrx
        return cp
    end
    obj.sec, obj.y = self, y

    self:_h({ ox = 0, oy = y, w = self.box.w, h = 18,
        onDown = function() obj:Set(not obj.value) end,
        onHover = function(b) lbl.d.Color = b and T.White or T.Text bd.d.Color = b and T.Accent or T.Border end })

    reg(id, obj, obj.value)
    return obj
end

----------------------------------------------------------------------
-- Slider
----------------------------------------------------------------------
function Section:AddSlider(id, label, lo, hi, default, opts)
    opts = opts or {}
    local win = self.win
    local bw = self.box.w - 16
    local y = self:_grow(36)
    local dec = opts.Decimals or 0
    local suffix = opts.Suffix or ""
    local obj = { id = id, type = "Slider", min = lo, max = hi, cb = opts.Callback }
    obj.value = clamp(default or lo, lo, hi)

    self:_r("Text", { Text = U(label), Color = T.Text, Font = FONT, Size = 12, ZIndex = 5 }, 8, y + 1)
    self:_r("Square", { Filled = true, Color = T.Box, Size = V2(bw, 14), ZIndex = 5 }, 8, y + 18)
    local fill = self:_r("Square", { Filled = true, Color = T.Accent, Size = V2(bw, 14), ZIndex = 6 }, 8, y + 18)
    local bd = self:_r("Square", { Filled = false, Thickness = 1, Color = T.Border, Size = V2(bw, 14), ZIndex = 7 }, 8, y + 18)
    local txt = self:_r("Text", { Text = "", Color = T.White, Font = FONT, Size = 12, Center = true, ZIndex = 8 }, 8 + bw / 2, y + 25)

    local fmt = "%." .. dec .. "f"
    local function show()
        local s = string.format(fmt, obj.value) .. suffix
        if opts.ShowMax then s = s .. "/" .. string.format(fmt, hi) .. suffix end
        txt.d.Text = U(s)
        local w = (obj.value - lo) / max(hi - lo, 1e-9) * bw
        fill.hidden = w < 1
        if not fill.hidden then fill.d.Size = V2(w, 14) end
        win:_sync()
    end
    show()

    function obj:Set(v, silent)
        local m = 10 ^ dec
        v = floor(clamp(v, lo, hi) * m + 0.5) / m
        if v == self.value and txt.d.Text ~= "" then return end
        self.value = v
        Lib.Flags[id or ""] = v
        show()
        if self.cb and not silent then pcall(self.cb, v) end
    end
    function obj:Get() return self.value end
    function obj:Export() return self.value end
    function obj:Import(v) if type(v) == "number" then self:Set(v) end end

    local function fromMouse(mx, _, h)
        obj:Set(lo + (hi - lo) * clamp((mx - h.ax) / bw, 0, 1))
    end
    self:_h({ ox = 8, oy = y + 16, w = bw, h = 18, onDown = fromMouse, onDrag = fromMouse,
        onHover = function(b) bd.d.Color = b and T.Accent or T.Border end })

    reg(id, obj, obj.value)
    return obj
end

----------------------------------------------------------------------
-- Dropdown (single or multi select)
----------------------------------------------------------------------
function Section:AddDropdown(id, label, options, default, cb, multi)
    local win = self.win
    local bw = self.box.w - 16
    local y = self:_grow(38)
    local obj = { id = id, type = "Dropdown", options = options, multi = (multi == true), cb = cb }
    if obj.multi then
        obj.value = {}
        if type(default) == "table" then for _, v in ipairs(default) do obj.value[v] = true end end
    else
        obj.value = default or options[1]
    end

    self:_r("Text", { Text = U(label), Color = T.Text, Font = FONT, Size = 12, ZIndex = 5 }, 8, y + 1)
    self:_r("Square", { Filled = true, Color = T.Box, Size = V2(bw, 16), ZIndex = 5 }, 8, y + 18)
    local bd = self:_r("Square", { Filled = false, Thickness = 1, Color = T.Border, Size = V2(bw, 16), ZIndex = 6 }, 8, y + 18)
    local txt = self:_r("Text", { Text = "", Color = T.Text, Font = FONT, Size = 12, ZIndex = 7 }, 14, y + 20)
    self:_r("Text", { Text = "v", Color = T.TextDim, Font = FONT, Size = 12, ZIndex = 7 }, 8 + bw - 14, y + 20)

    local maxc = max(floor((bw - 34) / 7), 4)
    local function display()
        local s
        if obj.multi then
            local t = {}
            for _, o in ipairs(options) do if obj.value[o] then t[#t + 1] = o end end
            s = (#t == 0) and "None" or table.concat(t, ", ")
        else
            s = tostring(obj.value)
        end
        if #s > maxc then s = string.sub(s, 1, maxc - 2) .. ".." end
        txt.d.Text = U(s)
        win:_sync()
    end
    display()

    function obj:Set(v, silent)
        if self.multi then
            local t = {}
            if type(v) == "table" then
                for k, x in pairs(v) do
                    if type(k) == "number" then t[x] = true elseif x == true then t[k] = true end
                end
            end
            self.value = t
        else
            self.value = v
        end
        Lib.Flags[id or ""] = self.value
        display()
        if self.cb and not silent then pcall(self.cb, self.value) end
    end
    function obj:Get() return self.value end
    function obj:Export()
        if not self.multi then return self.value end
        local t = {}
        for _, o in ipairs(options) do if self.value[o] then t[#t + 1] = o end end
        return t
    end
    function obj:Import(v) self:Set(v) end

    self:_h({ ox = 8, oy = y + 18, w = bw, h = 16,
        onHover = function(b) bd.d.Color = b and T.Accent or T.Border end,
        onDown = function(_, _, h)
            local n = #options
            local ph = n * 16 + 4
            local ax, ay = h.ax - win.x, h.ay - win.y + 17
            if ay + ph > win.h - 2 then ay = h.ay - win.y - ph - 1 end
            local p = win:_openPopup(ax, ay, bw, ph)
            local rows = {}
            local function recolor()
                for i = 1, n do
                    local o = options[i]
                    local on = obj.multi and obj.value[o] or (not obj.multi and obj.value == o)
                    rows[i].txt.d.Color = on and T.Accent or T.Text
                end
            end
            for i = 1, n do
                local ry = 2 + (i - 1) * 16
                local row = {}
                row.bg = win:_prec(p, "Square", { Filled = true, Color = T.Panel, Size = V2(bw - 4, 16), ZIndex = 32 }, 2, ry)
                row.txt = win:_prec(p, "Text", { Text = U(options[i]), Color = T.Text, Font = FONT, Size = 12, ZIndex = 33 }, 8, ry + 2)
                rows[i] = row
                win:_phit(p, { ox = 2, oy = ry, w = bw - 4, h = 16,
                    onHover = function(b) row.bg.d.Color = b and T.Hover or T.Panel end,
                    onDown = function()
                        local o = options[i]
                        if obj.multi then
                            local t = {}
                            for k, x in pairs(obj.value) do t[k] = x end
                            t[o] = (not t[o]) or nil
                            obj:Set(t)
                            recolor()
                        else
                            obj:Set(o)
                            win:_closePopup()
                        end
                    end })
            end
            recolor()
        end })

    reg(id, obj, obj.value)
    return obj
end

