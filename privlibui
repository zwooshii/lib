----------------------------------------------------------------------
-- Live colours: Lib:SetColor("Accent", Color3) recolors every drawing that uses that theme colour.
-- Roles: Accent, Outline, Inner, GradA, GradB, Background, Panel, Box, Border, Text, TextDim, Hover, TabActive
----------------------------------------------------------------------
local DEFAULTS = {}
for k, v in pairs(T) do DEFAULTS[k] = v end

local function sameCol(a, b)
    return math.abs(a.R - b.R) < 0.002 and math.abs(a.G - b.G) < 0.002 and math.abs(a.B - b.B) < 0.002
end

function Lib:SetColor(role, c)
    local old = T[role]
    if not old or typeof(c) ~= "Color3" or sameCol(old, c) then return end
    T[role] = c
    local isGrad = (role == "GradA" or role == "GradB")
    -- gradient bars / slider fills change when a gradient colour changes, or (flat mode) when the Accent changes
    local barsChange = isGrad or (role == "Accent" and not Lib.UseGradient)
    local function walk(list)
        for i = 1, #list do
            local r = list[i]
            if r.gt then
                if barsChange then r.col = gradAt(r.gt) r.d.Color = r.col end
            elseif not isGrad and r.col and sameCol(r.col, old) then
                r.col = c
                r.d.Color = c
            end
        end
    end
    for i = 1, #Lib.Windows do
        local w = Lib.Windows[i]
        walk(w.chrome)
        for j = 1, #w.tabs do walk(w.tabs[j].recs) end
        if w.popup then walk(w.popup.recs) end
        if w.outlineRec and (role == "Accent" or role == "Outline" or role == "Background") then
            w.outlineRec.col = outlineCol()
            w.outlineRec.d.Color = w.outlineRec.col
        end
    end
end

function Lib:ResetColors()
    for role, c in pairs(DEFAULTS) do Lib:SetColor(role, c) end
end

-- UI Gradient on / off. Off = everything (bars, slider fills, outline, notification border) is the flat T.Accent.
-- On = bars and slider fills run GradA -> GradB and the window outline uses T.Outline.
function Lib:SetGradient(on)
    on = (on == true)
    if Lib.UseGradient == on then return end
    Lib.UseGradient = on
    local function walk(list)
        for i = 1, #list do
            local r = list[i]
            if r.gt then
                r.col = gradAt(r.gt)
                r.d.Color = r.col
            end
        end
    end
    for i = 1, #Lib.Windows do
        local w = Lib.Windows[i]
        walk(w.chrome)
        for j = 1, #w.tabs do walk(w.tabs[j].recs) end
        local o = w.outlineRec
        if o then
            o.col = outlineCol()
            o.d.Color = o.col
        end
    end
end

----------------------------------------------------------------------
-- Config
----------------------------------------------------------------------
function Lib:SaveConfig(name)
    if not writefile then return false, "writefile unavailable" end
    local data = {}
    for id, obj in pairs(Lib.Objects) do
        if obj.Export then data[id] = obj:Export() end
    end
    local ok, err = pcall(function() writefile("ProjectFuzz_" .. (name or "default") .. ".json", HttpService:JSONEncode(data)) end)
    return ok, err
end

function Lib:LoadConfig(name)
    local file = "ProjectFuzz_" .. (name or "default") .. ".json"
    if not (isfile and readfile and isfile(file)) then return false, "no config" end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(file)) end)
    if not ok or type(data) ~= "table" then return false, "unreadable config" end
    for id, v in pairs(data) do
        local obj = Lib.Objects[id]
        if obj and obj.Import then pcall(obj.Import, obj, v) end
    end
    return true
end

