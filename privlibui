local function Icon(o, k, name, cx, cy, s, col, a, z)
    local h = s / 2
    if name == "crosshair" then
        Circ(o, k .. "1", cx, cy, h - 1, col, a, z, false, 1.5)
        Circ(o, k .. "2", cx, cy, 1.5, col, a, z, true)
    elseif name == "brush" then
        Ln(o, k .. "1", cx - h + 2, cy + h - 2, cx + h - 2, cy - h + 2, col, a, z, 2.6)
        Circ(o, k .. "2", cx - h + 2, cy + h - 2, 2.2, col, a, z, true)
    elseif name == "mountain" then
        Tri(o, k .. "1", cx - h, cy + h - 2, cx - 1, cy - h + 2, cx + h - 4, cy + h - 2, col, a, z)
        Tri(o, k .. "2", cx - 1, cy + h - 2, cx + 3, cy - 2, cx + h + 1, cy + h - 2, col, a, z)
    elseif name == "blade" then
        Ln(o, k .. "1", cx - h + 2, cy + h - 2, cx + h - 2, cy - h + 2, col, a, z, 2.4)
        Ln(o, k .. "2", cx - 4, cy + 1, cx + 1, cy + 6, col, a, z, 1.6)
    elseif name == "bolt" then
        Ln(o, k .. "1", cx + 2, cy - h + 1, cx - 3, cy + 1, col, a, z, 2.2)
        Ln(o, k .. "2", cx - 3, cy + 1, cx + 2, cy + 1, col, a, z, 2.2)
        Ln(o, k .. "3", cx + 2, cy + 1, cx - 2, cy + h - 1, col, a, z, 2.2)
