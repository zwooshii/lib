    elseif name == "monitor" then
        Rect(o, k .. "1", cx - h + 1, cy - h + 2, s - 2, s - 6, col, a, z, false, 2, 1.4)
        Ln(o, k .. "2", cx - 3, cy + h - 1, cx + 3, cy + h - 1, col, a, z, 1.6)
    elseif name == "bell" then
        Circ(o, k .. "1", cx, cy - 1, h - 3, col, a, z, false, 1.6)
        Ln(o, k .. "2", cx - h + 2, cy + 3, cx + h - 2, cy + 3, col, a, z, 1.6)
        Circ(o, k .. "3", cx, cy + h - 1, 1.3, col, a, z, true)
    elseif name == "plus" then
        Ln(o, k .. "1", cx - h + 2, cy, cx + h - 2, cy, col, a, z, 1.6)
        Ln(o, k .. "2", cx, cy - h + 2, cx, cy + h - 2, col, a, z, 1.6)
