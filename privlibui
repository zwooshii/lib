    Box        = Color3.fromRGB(21, 20, 28),
    Border     = Color3.fromRGB(44, 42, 56),
    Inner      = Color3.fromRGB(30, 28, 40),    -- the inner line inside every border (window + boxes); dim, so borders stay subtle
    GradA      = Color3.fromRGB(130, 90, 255),  -- gradient start (only used while UI Gradient is on)
    GradB      = Color3.fromRGB(210, 110, 255), -- gradient end (only used while UI Gradient is on)
    Outline    = Color3.fromRGB(176, 124, 254), -- window outline while UI Gradient is on (flat mode uses Accent)
    Accent     = Color3.fromRGB(176, 124, 255), -- THE flat menu colour (bars, slider fill, toggle fill, active tab, hover, outline)
    Text       = Color3.fromRGB(205, 205, 215),
    TextDim    = Color3.fromRGB(125, 122, 140),
