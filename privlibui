local function drawBindList(hub)
    local a = ani(hub, "bla", hub:Get("bl") and 1 or 0, 10)
    if a < 0.01 then return end
    local activeOnly = hub:Get("bl_active")
    local rows = {}
    for _, it in ipairs(hub.bindList) do
        for _, b in ipairs(it.binds) do
            if b.show and b.vk ~= 0 then
                local act = bindActive(it, b)
                if act or not activeOnly then rows[#rows + 1] = { it.label, b.vk, act } end
            end
        end
    end
    local bl = hub.bl
    -- drag by header (raw mouse, only while the menu is open)
    if hub.open then
        local over = M.rawx >= bl.x and M.rawx <= bl.x + 156 and M.rawy >= bl.y and M.rawy <= bl.y + 30
        if M.pressed and over and not dragOwner then bl.drag = { M.rawx - bl.x, M.rawy - bl.y } end
    end
    if bl.drag then
        if M.down then bl.x = M.rawx - bl.drag[1]; bl.y = M.rawy - bl.drag[2] else bl.drag = nil end
    end
    local target = 30 + #rows * 22 + ((#rows > 0) and 8 or 2)
    local bh = ani(hub, "blh", target, 12)
    GA = a
    Box2(hub, "bl", bl.x, bl.y, 156, bh, C.group, C.border, 1, 150, 8)
    Icon(hub, "blic", "grid", bl.x + 18, bl.y + 15, 14, C.accent, 1, 153)
    Txt(hub, "blt", "Binds", bl.x + 32, bl.y + 15, C.text, 1, 153, 13, true)
    CLIP0, CLIP1 = bl.y + 30, bl.y + bh - 3
    for i, r in ipairs(rows) do
        local ry = bl.y + 30 + (i - 1) * 22
        local ra = ani(hub, "blr" .. i, r[3] and 1 or 0, 12)
        Txt(hub, "bll" .. i, r[1], bl.x + 14, ry + 11, mix(C.dim, C.text, ra), 1, 153, 12, true)
        Txt(hub, "blk" .. i, "[" .. keyName(r[2]) .. "]", bl.x + 156 - 12, ry + 11, mix(C.dim, C.accent, ra), 1, 153, 12, true, "r")
    end
    CLIP0, CLIP1 = nil, nil
    GA = 1
end

local function drawToasts(hub)
    local vw, vh = Camera.ViewportSize.X, Camera.ViewportSize.Y
    local pos = hub:Get("toast_pos") or "Center Bottom"
    local bottom = pos:find("Bottom") ~= nil
    local cursor = 0
    for i = #hub.toasts, 1, -1 do
        local t = hub.toasts[i]
        local h = t.total and 56 or 46
        local sub = t.total and (floor(t.cur) .. "/" .. t.total) or t.text
        local w = max(190, tw(t.title, 13) + (t.icon and 70 or 36), tw(sub, 12) + (t.icon and 70 or 36))
        if t.dur and tick() - t.born > t.dur then t.closing = true end
        local life = ani(t, "in", t.closing and 0 or 1, 12)
        if t.closing and life < 0.02 then
            release(t); table.remove(hub.toasts, i)
        else
            local slot = ani(t, "slot", cursor, 12)
            cursor = cursor + (h + 8) * life
            local x
            if pos:find("Left") then x = 16 elseif pos:find("Right") then x = vw - w - 16 else x = (vw - w) / 2 end
            local y
            if bottom then y = vh - 28 - h - slot + (1 - life) * 18 else y = 28 + slot - (1 - life) * 18 end
            GA = life
            Box2(t, "bg", x, y, w, h, C.popup, C.border, 1, 300, 9)
            local tx = x + 16
            if t.icon then
                Icon(t, "ic", t.icon, x + 26, y + h / 2 - (t.total and 4 or 0), 18, C.text, 1, 303)
                tx = x + 48
            end
            Txt(t, "ti", t.title, tx, y + 17, C.text, 1, 303, 13, true)
            Txt(t, "tx", sub, tx, y + 33, C.dim, 1, 303, 12, false)
            if t.total then
                local bw = w - 32
                local f = ani(t, "f", clamp(t.cur / t.total, 0, 1), 14)
                Rect(t, "tr", x + 16, y + h - 12, bw, 3, C.track, 1, 303, true, 1.5)
                Rect(t, "fl", x + 16, y + h - 12, max(2, bw * f), 3, C.text, 1, 304, true, 1.5)
            end
            GA = 1
        end
    end
end

--========================================================================
-- Frame step
--========================================================================
local function pollInput()
    M.rawx, M.rawy = Mouse.X, Mouse.Y
    local down = ismouse1pressed() and isrbxactive()
    M.pressed = down and not M.down
    M.down = down
    M.x, M.y = (M.rawx - OX) / SCL, (M.rawy - OY) / SCL
end

local function step(hub)
    local now = tick()
    DT = clamp(now - hub.last, 0.001, 0.05)
    hub.last = now
    frameId = frameId + 1
    hub.fps = lerp(hub.fps, 1 / DT, 0.05)
    stepTheme()

    -- settings that drive the menu itself
    local dpi = hub:Get("dpi")
    hub.scl = dpi and ((tonumber((dpi:gsub("%%", ""))) or 100) / 100) or 1
    local fade = ani(hub, "fade", hub.open and 1 or 0, 12)
    SCL = hub.scl
    OX = hub.pos[1]
    OY = hub.pos[2] + (1 - fade) * 14
    GA = 1; CLIP0, CLIP1 = nil, nil
    pollInput()

    local active = isrbxactive()
    local busy = false

    -- key capture (bind rebinding)
    if CAP and active then
        busy = true
        for vk = 2, 254 do
            local _, p = key(vk)
            if p then
                local c = CAP; CAP = nil
                if vk ~= 0x1B then c.set(vk) end
                break
            end
        end
    end
    -- text input
    if TI.owner and active then
        busy = true
        local o = TI.owner
        local changed = false
        local shift = key(0x10)
        for _, vk in ipairs(TYPEVK) do
            local _, p = key(vk)
            if p and #o.text < 24 then
                local ch = vkChar(vk, shift)
                if ch then o.text = o.text .. ch; changed = true end
            end
        end
        local bd, bp = key(8)
        if bp then o.text = o.text:sub(1, #o.text - 1); TI.bs = 0; changed = true
        elseif bd then
            TI.bs = TI.bs + DT
            if TI.bs > 0.45 then o.text = o.text:sub(1, #o.text - 1); TI.bs = 0.4; changed = true end
        end
        local _, ent = key(13)
        local _, esc = key(27)
        if ent or esc then TI.owner = nil end
        if changed and o.onText then o.onText(o.text) end
    end

    -- menu toggle
    if active and not busy then
        local _, p = key(hub:Get("menu_key") or 0x46)
        if p then
            hub.open = not hub.open
            if not hub.open then closePop(); TI.owner = nil end
        end
    end

    -- bind processing (works with the menu closed)
    if active and not busy then
        for _, it in ipairs(hub.bindList) do
            for _, b in ipairs(it.binds) do
                if b.vk ~= 0 and b.mode ~= "Off" then
                    local d, p = key(b.vk)
                    if b.mode == "Toggle" then
                        if p then it:Set(not it.value) end
                    elseif d ~= b.last then
                        b.last = d
                        it:Set(d)
                    end
                end
            end
        end
    end

    -- mouse wheel scroll (best effort) is applied in the input hook below
    ctxOK = hub.open and fade > 0.85 and not (POP and not POP.closing)

    -- window dragging
    if hub.drag then
        if M.down then
            hub.pos[1] = M.rawx - hub.drag[1]
            hub.pos[2] = M.rawy - hub.drag[2] + 0
        else hub.drag = nil end
    elseif ctxOK and M.pressed and not dragOwner and M.y >= 0 and M.y < HDR and M.x >= 0 and M.x <= W - 110
        and not (M.x > SW + 10 and M.x < SW + 250) then
        hub.drag = { M.rawx - hub.pos[1], M.rawy - hub.pos[2] }
    end

    -- screen-space HUD
    local mOX, mOY, mSCL = OX, OY, SCL
    OX, OY, SCL = 0, 0, 1
    local vw, vh = Camera.ViewportSize.X, Camera.ViewportSize.Y
    if hub:Get("blur") then
        local bd = ani(hub, "bd", hub.open and (hub:Get("blurpx") or 40) / 100 * 0.55 or 0, 8)
        Rect(hub, "bd", 0, 0, vw, vh, C.black, bd, 0, true, 0)
    end
    drawWatermark(hub)
    drawBindList(hub)
    drawToasts(hub)
    OX, OY, SCL = mOX, mOY, mSCL

    -- menu
    local trans = (hub:Get("trans") or 0) / 100
    GA = fade * (1 - trans)
    if fade > 0.01 then
        drawWindow(hub)
        drawSidebar(hub)
        drawHeader(hub)
        drawContent(hub)
    end
    drawPopup(hub)
    GA = 1; CLIP0, CLIP1 = nil, nil

    -- end-of-frame input housekeeping
    if dragOwner and not M.down then dragOwner = nil end
    if M.pressed and TI.owner and TI.owner.hovFrame ~= frameId then TI.owner = nil end

    -- startup toast
    if not hub.startToast and now - hub.born > 0.6 then
        hub.startToast = true
        hub:Toast({ Title = "Loaded cloud config", Text = "Unnamed 3", Icon = "download", Duration = 3.5 })
    end
    sweep()
end

--========================================================================
-- Constructor
--========================================================================
function Lime.Create(opts)
    opts = opts or {}
    local hub = setmetatable({}, Lime)
    hub.title = opts.Title or "placeholder"
    hub.pos = opts.Position or { 60, 40 }
    hub.pages, hub.cats, hub.items, hub.bindList, hub.toasts = {}, {}, {}, {}, {}
    hub.open = true
    hub.query = ""
    hub.clock, hub.scroll, hub.scrollT, hub.maxScroll = 0, 0, 0, 0
    hub.scl, hub.fps = 1, 60
    hub.last, hub.born = tick(), tick()
    hub.bl = { x = 16, y = 260 }
    hub.searchBox = { text = "", onText = function(t) hub.query = t; hub.scrollT = 0 end }
    hub.scope = newItem("choice", { label = "", items = { "Global", "Pistols", "Rifles", "Snipers" }, value = 1, cw = 84, bare = true, h = 20 })
    hub.PageAPI = PageAPI
    return hub
end

function Lime:Run()
    local first = self.items["show_on_load"]
    if first then self.open = first.value end
    _G.__PlaceholderHub = self
    self.conn = RunService.RenderStepped:Connect(function()
        if self.dead then return end
        local ok, err = pcall(step, self)
        if not ok and not self.warned then self.warned = true; warn("[placeholder] " .. tostring(err)) end
    end)
end

-- best-effort mouse wheel support (ignored silently if the API isn't available)
local function hookWheel(hub)
    pcall(function()
        local UIS = game:GetService("UserInputService")
        UIS.InputChanged:Connect(function(input)
            if hub.dead then return end
            if input.UserInputType == Enum.UserInputType.MouseWheel and hub.open then
                hub.scrollT = clamp(hub.scrollT - input.Position.Z * 48, 0, hub.maxScroll)
            end
        end)
    end)
end

