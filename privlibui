----------------------------------------------------------------------
-- Keybind (also usable as a toggle addon)
----------------------------------------------------------------------
function Section:_keybindAt(id, y, rx, default, mode, cb)
    local win = self.win
    local kb = { id = id, type = "Keybind", key = default or 0, mode = mode or "Toggle", cb = cb }
    kb.state = (kb.mode == "Always")
    -- the box is as wide as its text (min 26px), like the concept: [C] [NONE] [CAPS]
    local function kw() return max(26, #keyName(kb.key) * 6 + 10) end
    local kwid = kw()
    local x = rx - kwid
    local bgR = self:_r("Square", { Filled = true, Color = T.Box, Size = V2(kwid, 13), ZIndex = 5 }, x, y + 2)
    local bd = self:_r("Square", { Filled = false, Thickness = 1, Color = T.Border, Size = V2(kwid, 13), ZIndex = 6 }, x, y + 2)
    kb.txt = self:_r("Text", { Text = keyName(kb.key), Color = T.Text, Font = FONT, Size = 10, Center = true, ZIndex = 7 }, x + kwid / 2, y + 8)
    local hit

    function kb:Set(key)
        self.key = key or 0
        self.txt.d.Text = keyName(self.key)
        self.txt.d.Color = T.Text
        local w = kw()
        if w ~= kwid and hit then
            kwid = w
            local nx = rx - w
            bgR.ox, bd.ox, hit.ox, hit.w = nx, nx, nx, w
            self.txt.ox = nx + w / 2
            bgR.d.Size, bd.d.Size = V2(w, 13), V2(w, 13)
            win:_put(bgR) win:_put(bd) win:_put(self.txt)
        end
        Lib.Flags[id or ""] = self.state
    end
    function kb:Get() return self.state end
    function kb:IsActive() return self.state end
    function kb:Export() return { self.key, self.mode } end
    function kb:Import(v) if type(v) == "table" then self.mode = v[2] or self.mode self:Set(v[1]) end end

    hit = self:_h({ ox = x, oy = y + 2, w = kwid, h = 13,
        onDown = function()
            win.listening = kb
            win.listenAt = tick()
            kb.txt.d.Text = "..."
            kb.txt.d.Color = T.Accent
        end,
        onHover = function(b) bd.d.Color = b and T.Accent or T.Border end })

    win.keybinds[#win.keybinds + 1] = kb
    reg(id, kb, kb.state)
    return kb, x - 6
end

function Section:AddKeybind(id, label, default, mode, cb)
    local ind = self:_ind()
    local y = self:_grow(18)
    self:_r("Text", { Text = U(label), Color = T.Text, Font = FONT, Size = 12, ZIndex = 5 }, 8 + ind, y + 3)
    local kb = self:_keybindAt(id, y, self.box.w - 8, default, mode, cb)
    return kb
end

----------------------------------------------------------------------
-- Colour picker (also usable as a toggle addon)
----------------------------------------------------------------------
function Section:_colorAt(id, y, rx, default, cb)
    local win = self.win
    local cp = { id = id, type = "Color", value = default or T.White, cb = cb }
    local x = rx - 22
    local sw = self:_r("Square", { Filled = true, Color = cp.value, Size = V2(22, 10), ZIndex = 5 }, x, y + 4)
    local bd = self:_r("Square", { Filled = false, Thickness = 1, Color = T.Border, Size = V2(22, 10), ZIndex = 6 }, x, y + 4)

    function cp:Set(c, silent)
        self.value = c
        sw.d.Color = c
        Lib.Flags[id or ""] = c
        if self.cb and not silent then pcall(self.cb, c) end
    end
    function cp:Get() return self.value end
    function cp:Export() return { self.value.R, self.value.G, self.value.B } end
    function cp:Import(v) if type(v) == "table" and v[1] then self:Set(Color3.new(v[1], v[2], v[3])) end end

    self:_h({ ox = x, oy = y + 4, w = 22, h = 10,
        onDown = function(_, _, h)
            local ax, ay = h.ax - win.x, h.ay - win.y
            local pw, ph = 160, 94
            local py = ay + 16
            if py + ph > win.h - 2 then py = ay - ph - 4 end
            local p = win:_openPopup(ax - pw + 22, py, pw, ph)
            local prev = win:_prec(p, "Square", { Filled = true, Color = cp.value, Size = V2(pw - 12, 14), ZIndex = 32 }, 6, 6)
            local chans = { "R", "G", "B" }
            local vals = { floor(cp.value.R * 255 + 0.5), floor(cp.value.G * 255 + 0.5), floor(cp.value.B * 255 + 0.5) }
            local fills, txts = {}, {}
            local BW = 100
            local function apply()
                local c = Color3.fromRGB(vals[1], vals[2], vals[3])
                prev.d.Color = c
                cp:Set(c)
                for i = 1, 3 do
                    fills[i].d.Size = V2(max(vals[i] / 255 * BW, 1), 10)
                    txts[i].d.Text = tostring(vals[i])
                end
            end
            for i = 1, 3 do
                local ry = 28 + (i - 1) * 20
                win:_prec(p, "Text", { Text = chans[i], Color = T.TextDim, Font = FONT, Size = 12, ZIndex = 32 }, 6, ry - 1)
                win:_prec(p, "Square", { Filled = true, Color = T.Box, Size = V2(BW, 10), ZIndex = 32 }, 22, ry)
                fills[i] = win:_prec(p, "Square", { Filled = true, Color = T.Accent, Size = V2(max(vals[i] / 255 * BW, 1), 10), ZIndex = 33 }, 22, ry)
                win:_prec(p, "Square", { Filled = false, Thickness = 1, Color = T.Border, Size = V2(BW, 10), ZIndex = 34 }, 22, ry)
                txts[i] = win:_prec(p, "Text", { Text = tostring(vals[i]), Color = T.Text, Font = FONT, Size = 12, ZIndex = 33 }, 128, ry - 1)
                local function setFrom(mx, _, hh)
                    vals[i] = floor(clamp((mx - hh.ax) / BW, 0, 1) * 255 + 0.5)
                    apply()
                end
                win:_phit(p, { ox = 22, oy = ry - 2, w = BW, h = 14, onDown = setFrom, onDrag = setFrom })
            end
        end,
        onHover = function(b) bd.d.Color = b and T.Accent or T.Border end })

    reg(id, cp, cp.value)
    return cp, x - 6
end

function Section:AddColorPicker(id, label, default, cb)
    local ind = self:_ind()
    local y = self:_grow(18)
    self:_r("Text", { Text = U(label), Color = T.Text, Font = FONT, Size = 12, ZIndex = 5 }, 8 + ind, y + 3)
    local cp = self:_colorAt(id, y, self.box.w - 8, default, cb)
    return cp
end

----------------------------------------------------------------------
-- Toggle
----------------------------------------------------------------------
function Section:AddToggle(id, label, default, cb)
    local win = self.win
    local ind = self:_ind()
    local y = self:_grow(18)
    local obj = { id = id, type = "Toggle", value = (default == true), cb = cb, rx = self.box.w - 8 }
    local frame = self:_r("Square", { Filled = true, Color = T.Box, Size = V2(12, 12), ZIndex = 5 }, 8 + ind, y + 3)
    local bd = self:_r("Square", { Filled = false, Thickness = 1, Color = T.Border, Size = V2(12, 12), ZIndex = 6 }, 8 + ind, y + 3)
    local fill = self:_r("Square", { Filled = true, Color = T.Accent, Size = V2(8, 8), ZIndex = 7 }, 10 + ind, y + 5)
    local lbl = self:_r("Text", { Text = U(label), Color = T.Text, Font = FONT, Size = 12, ZIndex = 6 }, 26 + ind, y + 3)
    fill.hidden = not obj.value

    function obj:Set(v, silent)
        v = (v == true)
        if v == self.value and fill.hidden == (not v) then return end
        self.value = v
        fill.hidden = not v
        Lib.Flags[id or ""] = v
        win:_sync()
        if self.cb and not silent then pcall(self.cb, v) end
    end
    function obj:Get() return self.value end
    function obj:Export() return self.value end
    function obj:Import(v) if type(v) == "boolean" then self:Set(v) end end
    -- addons belong to the same fold as the toggle they sit on
    function obj:AddKeybind(kid, default, mode, kcb)
        local s = self.sec
        local prev = s.fold
        s.fold = self.fold
        local kb, nrx = s:_keybindAt(kid, self.y, self.rx, default, mode, kcb)
        s.fold = prev
        self.rx = nrx
        return kb
    end
    function obj:AddColorPicker(cid, color, ccb)
        local s = self.sec
        local prev = s.fold
        s.fold = self.fold
        local cp, nrx = s:_colorAt(cid, self.y, self.rx, color, ccb)
        s.fold = prev
        self.rx = nrx
        return cp
    end
    obj.sec, obj.y, obj.fold = self, y, self.fold

    self:_h({ ox = 0, oy = y, w = self.box.w, h = 18,
        onDown = function() obj:Set(not obj.value) end,
        onHover = function(b) lbl.d.Color = b and T.White or T.Text bd.d.Color = b and T.Accent or T.Border end })

    reg(id, obj, obj.value)
    return obj
end

----------------------------------------------------------------------
-- Slider
----------------------------------------------------------------------
function Section:AddSlider(id, label, lo, hi, default, opts)
    opts = opts or {}
    local win = self.win
    local ind = self:_ind()
    local bw = self.box.w - 16 - ind
    local y = self:_grow(32)
    local dec = opts.Decimals or 0
    local suffix = opts.Suffix or ""
    local obj = { id = id, type = "Slider", min = lo, max = hi, cb = opts.Callback }
    obj.value = clamp(default or lo, lo, hi)

    self:_r("Text", { Text = U(label), Color = T.Text, Font = FONT, Size = 12, ZIndex = 5 }, 8 + ind, y + 1)
    self:_r("Square", { Filled = true, Color = T.Box, Size = V2(bw, 12), ZIndex = 5 }, 8 + ind, y + 16)
    local SEG = 24
    local segs, segW = {}, bw / SEG
    for i = 1, SEG do
        segs[i] = self:_r("Square", { Filled = true, Color = gradAt((i - 0.5) / SEG), Size = V2(segW + 1, 12), ZIndex = 6 }, 8 + ind + (i - 1) * segW, y + 16)
        segs[i].hidden = true
        segs[i].gt = (i - 0.5) / SEG
    end
    local bd = self:_r("Square", { Filled = false, Thickness = 1, Color = T.Border, Size = V2(bw, 12), ZIndex = 7 }, 8 + ind, y + 16)
    local txt = self:_r("Text", { Text = "", Color = T.White, Font = FONT, Size = 12, Center = true, ZIndex = 8 }, 8 + ind + bw / 2, y + 22)

    local fmt = "%." .. dec .. "f"
    local function show()
        local s = string.format(fmt, obj.value) .. suffix
        if opts.ShowMax then s = s .. "/" .. string.format(fmt, hi) .. suffix end
        txt.d.Text = U(s)
        local w = (obj.value - lo) / max(hi - lo, 1e-9) * bw
        for i = 1, SEG do
            local sx = (i - 1) * segW
            local seg = segs[i]
            if w > sx + 0.5 then
                seg.hidden = false
                seg.d.Size = V2(min(segW + 1, w - sx), 12)
            else
                seg.hidden = true
            end
        end
        win:_sync()
    end
    show()

    function obj:Set(v, silent)
        local m = 10 ^ dec
        v = floor(clamp(v, lo, hi) * m + 0.5) / m
        if v == self.value and txt.d.Text ~= "" then return end
        self.value = v
        Lib.Flags[id or ""] = v
        show()
        if self.cb and not silent then pcall(self.cb, v) end
    end
    function obj:Get() return self.value end
    function obj:Export() return self.value end
    function obj:Import(v) if type(v) == "number" then self:Set(v) end end

    local function fromMouse(mx, _, h)
        obj:Set(lo + (hi - lo) * clamp((mx - h.ax) / bw, 0, 1))
    end
    self:_h({ ox = 8 + ind, oy = y + 14, w = bw, h = 16, onDown = fromMouse, onDrag = fromMouse,
        onHover = function(b) bd.d.Color = b and T.Accent or T.Border end })

    reg(id, obj, obj.value)
    return obj
end

----------------------------------------------------------------------
-- Dropdown (single or multi select)
----------------------------------------------------------------------
function Section:AddDropdown(id, label, options, default, cb, multi)
    local win = self.win
    local ind = self:_ind()
    local bw = self.box.w - 16 - ind
    local dy = (label ~= nil and label ~= "") and 18 or 0
    local y = self:_grow(dy + 20)
    local obj = { id = id, type = "Dropdown", options = options, multi = (multi == true), cb = cb }
    if obj.multi then
        obj.value = {}
        if type(default) == "table" then for _, v in ipairs(default) do obj.value[v] = true end end
    else
        obj.value = default or options[1]
    end

    if dy > 0 then
        self:_r("Text", { Text = U(label), Color = T.Text, Font = FONT, Size = 12, ZIndex = 5 }, 8 + ind, y + 1)
    end
    self:_r("Square", { Filled = true, Color = T.Box, Size = V2(bw, 16), ZIndex = 5 }, 8 + ind, y + dy)
    local bd = self:_r("Square", { Filled = false, Thickness = 1, Color = T.Border, Size = V2(bw, 16), ZIndex = 6 }, 8 + ind, y + dy)
    local txt = self:_r("Text", { Text = "", Color = T.Text, Font = FONT, Size = 12, ZIndex = 7 }, 14 + ind, y + dy + 2)
    -- small pixel arrow (5 / 3 / 1 px rows)
    self:_r("Square", { Filled = true, Color = T.TextDim, Size = V2(3, 1), ZIndex = 7 }, 8 + ind + bw - 11, y + dy + 6)
    self:_r("Square", { Filled = true, Color = T.TextDim, Size = V2(1, 1), ZIndex = 7 }, 8 + ind + bw - 10, y + dy + 7)

    local maxc = max(floor((bw - 34) / 7), 4)
    local function display()
        local s
        if obj.multi then
            local t = {}
            for _, o in ipairs(options) do if obj.value[o] then t[#t + 1] = o end end
            s = (#t == 0) and "None" or table.concat(t, ", ")
        else
            s = tostring(obj.value)
        end
        if #s > maxc then s = string.sub(s, 1, maxc - 2) .. ".." end
        txt.d.Text = U(s)
        win:_sync()
    end
    display()

    function obj:Set(v, silent)
        if self.multi then
            local t = {}
            if type(v) == "table" then
                for k, x in pairs(v) do
                    if type(k) == "number" then t[x] = true elseif x == true then t[k] = true end
                end
            end
            self.value = t
        else
            self.value = v
        end
        Lib.Flags[id or ""] = self.value
        display()
        if self.cb and not silent then pcall(self.cb, self.value) end
    end
    function obj:Get() return self.value end
    function obj:Export()
        if not self.multi then return self.value end
        local t = {}
        for _, o in ipairs(options) do if self.value[o] then t[#t + 1] = o end end
        return t
    end
    function obj:Import(v) self:Set(v) end

    self:_h({ ox = 8 + ind, oy = y + dy, w = bw, h = 16,
        onHover = function(b) bd.d.Color = b and T.Accent or T.Border end,
        onDown = function(_, _, h)
            local n = #options
            local ph = n * 16 + 4
            local ax, ay = h.ax - win.x, h.ay - win.y + 17
            if ay + ph > win.h - 2 then ay = h.ay - win.y - ph - 1 end
            local p = win:_openPopup(ax, ay, bw, ph)
            local rows = {}
            local function recolor()
                for i = 1, n do
                    local o = options[i]
                    local on = obj.multi and obj.value[o] or (not obj.multi and obj.value == o)
                    rows[i].txt.d.Color = on and T.Accent or T.Text
                end
            end
            for i = 1, n do
                local ry = 2 + (i - 1) * 16
                local row = {}
                row.bg = win:_prec(p, "Square", { Filled = true, Color = T.Panel, Size = V2(bw - 4, 16), ZIndex = 32 }, 2, ry)
                row.txt = win:_prec(p, "Text", { Text = U(options[i]), Color = T.Text, Font = FONT, Size = 12, ZIndex = 33 }, 8, ry + 2)
                rows[i] = row
                win:_phit(p, { ox = 2, oy = ry, w = bw - 4, h = 16,
                    onHover = function(b) row.bg.d.Color = b and T.Hover or T.Panel end,
                    onDown = function()
                        local o = options[i]
                        if obj.multi then
                            local t = {}
                            for k, x in pairs(obj.value) do t[k] = x end
                            t[o] = (not t[o]) or nil
                            obj:Set(t)
                            recolor()
                        else
                            obj:Set(o)
                            win:_closePopup()
                        end
                    end })
            end
            recolor()
        end })

    reg(id, obj, obj.value)
    return obj
end

