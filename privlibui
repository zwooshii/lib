local Lime = {}
Lime.__index = Lime

function Lime:Get(id) local it = self.items[id]; if it then return it:Get() end end
function Lime:Set(id, v) local it = self.items[id]; if it then it:Set(v) end end

function Lime:Page(name, opts)
    opts = opts or {}
    local p = setmetatable({ hub = self, name = name, icon = opts.icon, boxes = {}, children = {} }, PageAPI)
    if opts.parent then
        for _, pp in ipairs(self.pages) do
            if pp.name == opts.parent then p.parent = pp; pp.children[#pp.children + 1] = p end
        end
    else
        local cat
        for _, c in ipairs(self.cats) do if c.name == opts.category then cat = c end end
        if not cat then cat = { name = opts.category or "Other", pages = {} }; self.cats[#self.cats + 1] = cat end
        cat.pages[#cat.pages + 1] = p
    end
    self.pages[#self.pages + 1] = p
    return p
end

function Lime:Select(p)
    if not p then return end
    if #p.children > 0 then p = p.children[1] end
    if self.active ~= p then
        self.active = p
        self.clock = 0
        self.scrollT = 0
        if self.__a then self.__a.scroll = 0 end
        closePop()
    end
end

function Lime:Toast(o)
    local t = { title = o.Title or "", text = o.Text or "", icon = o.Icon, born = tick(), total = o.Total, cur = o.Current or 0 }
    t.dur = (not o.Total) and (o.Duration or 3) or nil
    function t:Set(v) self.cur = v end
    function t:Close() self.closing = true end
    table.insert(self.toasts, t)
    return t
end

function Lime:Destroy()
    self.dead = true
    if self.conn then self.conn:Disconnect(); self.conn = nil end
    for i = 1, #pool do pcall(function() pool[i].obj:Remove() end) end
    pool = {}
    if _G.__PlaceholderHub == self then _G.__PlaceholderHub = nil end
end

