local mouse
do
    local okM, m = pcall(function() return Players.LocalPlayer:GetMouse() end)
    if okM and m then
        mouse = m
    else
        mouse = { X = 0, Y = 0 }
        warn("[ProjectFuzz] could not get the mouse, clicking will not work")
    end
end

local function hitTest(win, list, mx, my)
    for i = #list, 1, -1 do
        local h = list[i]
        if win:_vis(h) then
            local ax, ay = win:_abs(h)
            if mx >= ax and mx <= ax + h.w and my >= ay and my <= ay + h.h then
                h.ax, h.ay = ax, ay
                return h
            end
        end
    end
    return nil
end

function Window:_step(mx, my, down)
    -- menu key
    if not self.listening and iskeypressed then
        local k = iskeypressed(self.toggleKey) == true
        if k and not self.tkDown then self:SetVisible(not self.visible) end
        self.tkDown = k
    end

    local a = self.active
    if a and a.dirty and self.visible then a:_reflow() end
    if self.syncDirty then self:_sync() end

    -- keybinds (run even while the menu is hidden)
    if iskeypressed then
        if self.listening then
            local kb = self.listening
            if tick() - self.listenAt > 0.15 then
                for vk = 3, 254 do
                    if vk ~= 1 and vk ~= 2 and iskeypressed(vk) == true then
                        kb:Set(vk == 27 and 0 or vk)
                        self.listening = nil
                        break
                    end
                end
            end
        else
            for i = 1, #self.keybinds do
                local kb = self.keybinds[i]
                if kb.key ~= 0 then
                    local d = iskeypressed(kb.key) == true
                    if kb.mode == "Hold" then
                        if d ~= kb.state then kb.state = d Lib.Flags[kb.id or ""] = d if kb.cb then pcall(kb.cb, d) end end
                    elseif kb.mode == "Always" then
                        kb.state = true
                    elseif d and not kb.down then
                        kb.state = not kb.state
                        Lib.Flags[kb.id or ""] = kb.state
                        if kb.cb then pcall(kb.cb, kb.state) end
                    end
                    kb.down = d
                end
            end
        end
    end

    if not self.visible then self.wasDown = down return end

    local was = self.wasDown
    self.wasDown = down
    local pop = self.popup

    if down and not was then
        if isrbxactive and not isrbxactive() then return end
        if pop then
            local h = hitTest(self, pop.hits, mx, my)
            if h then
                self.cap = h
                if h.onDown then h.onDown(mx, my, h) end
            else
                local px, py = self.x + pop.org.x, self.y + pop.org.y
                if not (mx >= px and mx <= px + pop.w and my >= py and my <= py + pop.h) then self:_closePopup() end
            end
            return
        end
        local h = hitTest(self, self.hits, mx, my)
        if h then
            self.cap = h
            if h.onDown then h.onDown(mx, my, h) end
        end
    elseif down then
        local c = self.cap
        if c and c.onDrag then
            c.ax, c.ay = self:_abs(c)
            c.onDrag(mx, my, c)
        end
    else
        local c = self.cap
        if c and c.onUp then c.onUp(mx, my, c) end
        self.cap = nil
        -- hover
        local cand
        if self.popup then cand = hitTest(self, self.popup.hits, mx, my) else cand = hitTest(self, self.hits, mx, my) end
        if cand ~= self.hover then
            local old = self.hover
            self.hover = cand
            if old and old.onHover then old.onHover(false) end
            if cand and cand.onHover then cand.onHover(true) end
        end
    end
end

local lastErr
local conn = RunService.RenderStepped:Connect(function()
    if not Lib.alive then return end
    local ok, err = pcall(function()
        local down = ismouse1pressed and ismouse1pressed() or false
        local mx, my = mouse.X, mouse.Y
        for i = 1, #Lib.Windows do Lib.Windows[i]:_step(mx, my, down) end

        local notes = Lib.Notes
        local changed = false
        for i = #notes, 1, -1 do
            local n = notes[i]
            if tick() - n.t0 >= n.secs then
                for _, d in ipairs({ n.bg, n.bd, n.bar, n.title, n.text }) do pcall(function() d:Remove() end) end
                table.remove(notes, i)
                changed = true
            end
        end
        if changed then layoutNotes() end
    end)
    if not ok and err ~= lastErr then
        lastErr = err
        warn("[ProjectFuzz] " .. tostring(err))
    end
end)

function Lib:Unload()
    Lib.alive = false
    pcall(function() conn:Disconnect() end)
    for i = #Lib.Windows, 1, -1 do pcall(Lib.Windows[i].Destroy, Lib.Windows[i]) end
    for _, n in ipairs(Lib.Notes) do
        for _, d in ipairs({ n.bg, n.bd, n.bar, n.title, n.text }) do pcall(function() d:Remove() end) end
    end
    Lib.Notes = {}
    if genv and genv.ProjectFuzzUI == Lib then genv.ProjectFuzzUI = nil end
end

print("[ProjectFuzz] library loaded")
return Lib

end)()

