--========================================================================
-- Pooled drawing
--========================================================================
local pool, deadCount = {}, 0

local function get(o, key, kind)
    local ds = o.__d
    if not ds then ds = {}; o.__d = ds end
    local d = ds[key]
    if not d then
        d = { obj = Drawing.new(kind), shown = false, seen = 0, c = {} }
        d.obj.Visible = false
        ds[key] = d
        pool[#pool + 1] = d
    end
    d.seen = frameId
    return d
end

local function release(o)
    if o.__d then
        for _, d in pairs(o.__d) do
            pcall(function() d.obj:Remove() end)
            d.dead = true; d.shown = false; deadCount = deadCount + 1
        end
        o.__d = nil
    end
end

local function sweep()
    if deadCount > 80 then
        local np = {}
        for i = 1, #pool do if not pool[i].dead then np[#np + 1] = pool[i] end end
        pool = np; deadCount = 0
    end
    for i = 1, #pool do
        local d = pool[i]
        if d.shown and d.seen ~= frameId then d.obj.Visible = false; d.shown = false end
    end
end

local function set(d, k, v)
    local c = d.c
    if c[k] ~= v then c[k] = v; d.obj[k] = v end
end
local function setcol(d, col)
    local c, r, g, b = d.c, col[1], col[2], col[3]
    if c.r ~= r or c.g ~= g or c.b ~= b then
        c.r = r; c.g = g; c.b = b
        d.obj.Color = Color3.new(r, g, b)
    end
end
local function show(d) if not d.shown then d.obj.Visible = true; d.shown = true end end
local function px(x) return floor(OX + x * SCL + 0.5) end
local function py(y) return floor(OY + y * SCL + 0.5) end

local function Rect(o, key, x, y, w, h, col, a, z, filled, corner, thick)
    a = (a or 1) * GA
    if a < 0.01 or w <= 0 or h <= 0 then return end
    if CLIP0 then
        if y >= CLIP1 or y + h <= CLIP0 then return end
        if y < CLIP0 then h = h - (CLIP0 - y); y = CLIP0 end
        if y + h > CLIP1 then h = CLIP1 - y end
        if h <= 0 then return end
    end
    local d = get(o, key, "Square")
    local c, obj = d.c, d.obj
    local X, Y, SX, SY = px(x), py(y), floor(w * SCL + 0.5), floor(h * SCL + 0.5)
    if c.px ~= X or c.py ~= Y then c.px = X; c.py = Y; obj.Position = Vector2.new(X, Y) end
    if c.sx ~= SX or c.sy ~= SY then c.sx = SX; c.sy = SY; obj.Size = Vector2.new(SX, SY) end
    setcol(d, col)
    set(d, "Transparency", floor(a * 100 + 0.5) / 100)
    set(d, "ZIndex", z)
    local f = filled ~= false
    set(d, "Filled", f)
    set(d, "Corner", floor(min((corner or 0) * SCL, SX / 2, SY / 2)))
    if not f then set(d, "Thickness", thick or 1) end
    show(d)
end

local function Box2(o, key, x, y, w, h, fill, border, a, z, corner)
    Rect(o, key .. "b", x, y, w, h, border, a, z, true, corner)
    Rect(o, key .. "f", x + 1, y + 1, w - 2, h - 2, fill, a, z + 1, true, max(0, (corner or 0) - 1))
end

local FONT, FONTB = Drawing.Fonts.System, Drawing.Fonts.SystemBold
-- cy is the vertical CENTER of the text; align: "l" (default), "r", "c"
local function Txt(o, key, s, x, cy, col, a, z, size, bold, align)
    a = (a or 1) * GA
    if a < 0.01 or s == nil or s == "" then return end
    size = size or 13
    if CLIP0 and (cy - size / 2 < CLIP0 - 1 or cy + size / 2 > CLIP1 + 1) then return end
    local d = get(o, key, "Text")
    local w = tw(s, size)
    if align == "r" then x = x - w elseif align == "c" then x = x - w / 2 end
    local c, obj = d.c, d.obj
    local X, Y = px(x), py(cy - size / 2 - 1)
    if c.px ~= X or c.py ~= Y then c.px = X; c.py = Y; obj.Position = Vector2.new(X, Y) end
    set(d, "Text", s)
    setcol(d, col)
    set(d, "Transparency", floor(a * 100 + 0.5) / 100)
    set(d, "ZIndex", z)
    set(d, "FontSize", floor(size * SCL + 0.5))
    set(d, "Font", bold and FONTB or FONT)
    set(d, "Outline", false)
    set(d, "Center", false)
    show(d)
end

local function Ln(o, key, x1, y1, x2, y2, col, a, z, th)
    a = (a or 1) * GA
    if a < 0.01 then return end
    if CLIP0 and (y1 < CLIP0 or y1 > CLIP1 or y2 < CLIP0 or y2 > CLIP1) then return end
    local d = get(o, key, "Line")
    local c, obj = d.c, d.obj
    local ax, ay, bx, by = px(x1), py(y1), px(x2), py(y2)
    if c.ax ~= ax or c.ay ~= ay then c.ax = ax; c.ay = ay; obj.From = Vector2.new(ax, ay) end
    if c.bx ~= bx or c.by ~= by then c.bx = bx; c.by = by; obj.To = Vector2.new(bx, by) end
    setcol(d, col)
    set(d, "Transparency", floor(a * 100 + 0.5) / 100)
    set(d, "ZIndex", z)
    set(d, "Thickness", th or 1)
    show(d)
end

local function Circ(o, key, x, y, r, col, a, z, filled, th)
    a = (a or 1) * GA
    if a < 0.01 then return end
    if CLIP0 and (y - r < CLIP0 or y + r > CLIP1) then return end
    local d = get(o, key, "Circle")
    local c, obj = d.c, d.obj
    local X, Y = px(x), py(y)
    if c.px ~= X or c.py ~= Y then c.px = X; c.py = Y; obj.Position = Vector2.new(X, Y) end
    set(d, "Radius", r * SCL)
    set(d, "NumSides", r > 8 and 40 or 24)
    setcol(d, col)
    set(d, "Transparency", floor(a * 100 + 0.5) / 100)
    set(d, "ZIndex", z)
    set(d, "Filled", filled ~= false)
    if filled == false then set(d, "Thickness", th or 1) end
    show(d)
end

local function Tri(o, key, ax, ay, bx, by, cx, cy, col, a, z)
    a = (a or 1) * GA
    if a < 0.01 then return end
    if CLIP0 and (ay < CLIP0 or ay > CLIP1 or by < CLIP0 or by > CLIP1 or cy < CLIP0 or cy > CLIP1) then return end
    local d = get(o, key, "Triangle")
    local c, obj = d.c, d.obj
    local A, B, Cc = { px(ax), py(ay) }, { px(bx), py(by) }, { px(cx), py(cy) }
    if c.a1 ~= A[1] or c.a2 ~= A[2] then c.a1 = A[1]; c.a2 = A[2]; obj.PointA = Vector2.new(A[1], A[2]) end
    if c.b1 ~= B[1] or c.b2 ~= B[2] then c.b1 = B[1]; c.b2 = B[2]; obj.PointB = Vector2.new(B[1], B[2]) end
    if c.c1 ~= Cc[1] or c.c2 ~= Cc[2] then c.c1 = Cc[1]; c.c2 = Cc[2]; obj.PointC = Vector2.new(Cc[1], Cc[2]) end
    setcol(d, col)
    set(d, "Transparency", floor(a * 100 + 0.5) / 100)
    set(d, "ZIndex", z)
    set(d, "Filled", true)
    show(d)
end

--========================================================================
-- Animation + input helpers
--========================================================================
local function ani(o, key, target, speed)
    local a = o.__a
    if not a then a = {}; o.__a = a end
    local v = a[key]
    if v == nil then a[key] = target; return target end
    v = v + (target - v) * (1 - exp(-(speed or 14) * DT))
    if abs(v - target) < 0.001 then v = target end
    a[key] = v
    return v
end

local function hot(x, y, w, h)
    if not ctxOK then return false end
    if CLIP0 and (M.y < CLIP0 or M.y > CLIP1) then return false end
    return M.x >= x and M.x <= x + w and M.y >= y and M.y <= y + h
end

-- keyboard (polled once per frame per key)
local kd, kp, kf = {}, {}, {}
local function key(vk)
    if kf[vk] ~= frameId then
        kf[vk] = frameId
        local d = iskeypressed(vk) and true or false
        kp[vk] = d and not kd[vk]
        kd[vk] = d
    end
    return kd[vk], kp[vk]
end
local function primeKeys()
    for vk = 1, 254 do
        kf[vk] = frameId
        kd[vk] = iskeypressed(vk) and true or false
        kp[vk] = false
    end
end

local KN = { [1] = "LMB", [2] = "RMB", [4] = "MMB", [5] = "X1", [6] = "X2", [8] = "Back", [9] = "Tab", [13] = "Enter",
    [16] = "Shift", [17] = "Ctrl", [18] = "Alt", [20] = "Caps", [27] = "Esc", [32] = "Space", [33] = "PgUp", [34] = "PgDn",
    [35] = "End", [36] = "Home", [37] = "Left", [38] = "Up", [39] = "Right", [40] = "Down", [45] = "Ins", [46] = "Del",
    [160] = "LShift", [161] = "RShift", [162] = "LCtrl", [163] = "RCtrl", [164] = "LAlt", [165] = "RAlt" }
for i = 0x30, 0x39 do KN[i] = string.char(i) end
for i = 0x41, 0x5A do KN[i] = string.char(i) end
for i = 1, 12 do KN[0x6F + i] = "F" .. i end
for i = 0, 9 do KN[0x60 + i] = "Num" .. i end
local function keyName(vk) if not vk or vk == 0 then return "None" end return KN[vk] or ("K" .. vk) end

local TYPEVK = {}
for vk = 0x30, 0x39 do TYPEVK[#TYPEVK + 1] = vk end
for vk = 0x41, 0x5A do TYPEVK[#TYPEVK + 1] = vk end
TYPEVK[#TYPEVK + 1] = 0x20; TYPEVK[#TYPEVK + 1] = 0xBD; TYPEVK[#TYPEVK + 1] = 0xBE
local function vkChar(vk, shift)
    if vk >= 0x41 and vk <= 0x5A then local ch = string.char(vk); return shift and ch or ch:lower() end
    if vk >= 0x30 and vk <= 0x39 then return string.char(vk) end
    if vk == 0x20 then return " " end
    if vk == 0xBD then return shift and "_" or "-" end
    if vk == 0xBE then return "." end
end

local function startCapture(owner, setfn) CAP = { owner = owner, set = setfn }; primeKeys() end
local function focusText(o) TI.owner = o; TI.bs = 0; primeKeys() end

