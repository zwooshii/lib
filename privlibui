Lib.Font = FONT

local PAD, GAP, TPAD = 17, 6, 12 -- box padding / gap between boxes / tab bar padding
local FOLD_IND = 8              -- rows inside a fold (e.g. under an enabled toggle) are pushed this far to the right
local TITLE_H, TABBAR_Y, TABBAR_H = 22, 27, 21
local CONTENT_Y = 55

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local floor, max, min = math.floor, math.max, math.min
local function clamp(v, lo, hi) if hi < lo then return lo end if v < lo then return lo end if v > hi then return hi end return v end
local function U(s) s = tostring(s) if Lib.Uppercase then return string.upper(s) end return s end
local function V2(x, y) return Vector2.new(x, y) end

-- the colour at position t (0..1) of the gradient; with UI Gradient off every position is the flat Accent
local function gradAt(t)
    if not Lib.UseGradient then return T.Accent end
    local a, b = T.GradA, T.GradB
    return Color3.new(a.R + (b.R - a.R) * t, a.G + (b.G - a.G) * t, a.B + (b.B - a.B) * t)
end
Lib.GradAt = gradAt

-- window / notification outline: its own colour in gradient mode, the flat Accent otherwise
local function outlineCol()
    local c = Lib.UseGradient and T.Outline or T.Accent
    local b, k = T.Background, 0.45 -- the concept's window outline is a dim version of the accent
    return Color3.new(b.R + (c.R - b.R) * k, b.G + (c.G - b.G) * k, b.B + (c.B - b.B) * k)
end

-- a horizontal 2px gradient bar built from n small squares; add(class, props, ox, oy) creates one drawing
local function gradBar(add, w, oy, n, zi)
    for i = 1, n do
        local x0, x1 = floor((i - 1) * w / n), floor(i * w / n)
        local r = add("Square", { Filled = true, Color = gradAt((i - 0.5) / n), Size = V2(x1 - x0, 2), ZIndex = zi }, x0, oy)
        if r then r.gt = (i - 0.5) / n end -- position in the gradient: lets SetColor recolor it later
    end
end

local viewSize
do
    local last = V2(1920, 1080)
    viewSize = function()
        local cam = Workspace.CurrentCamera
        if cam then local v = cam.ViewportSize if v then last = v end end
        return last
    end
end

local function mk(class, props)
    local d = Drawing.new(class)
    for k, v in pairs(props) do d[k] = v end
    if class == "Text" then d.Outline = false end
    d.Visible = false
    return d
end

local KEYNAMES = { [4] = "MB3", [5] = "MB4", [6] = "MB5", [8] = "BKSP", [9] = "TAB", [13] = "ENTER", [16] = "SHIFT", [17] = "CTRL",
    [18] = "ALT", [20] = "CAPS", [27] = "ESC", [32] = "SPACE", [33] = "PGUP", [34] = "PGDN", [35] = "END", [36] = "HOME",
    [37] = "LEFT", [38] = "UP", [39] = "RIGHT", [40] = "DOWN", [45] = "INS", [46] = "DEL", [160] = "LSHIFT", [161] = "RSHIFT",
    [162] = "LCTRL", [163] = "RCTRL", [164] = "LALT", [165] = "RALT" }
for i = 48, 57 do KEYNAMES[i] = string.char(i) end
for i = 65, 90 do KEYNAMES[i] = string.char(i) end
for i = 1, 12 do KEYNAMES[111 + i] = "F" .. i end
for i = 0, 9 do KEYNAMES[96 + i] = "NUM" .. i end
local function keyName(k) if not k or k == 0 then return "NONE" end return KEYNAMES[k] or ("K" .. k) end

local function reg(id, obj, value)
    if id then
        Lib.Objects[id] = obj
        Lib.Flags[id] = value
    end
end

----------------------------------------------------------------------
-- Classes
----------------------------------------------------------------------
local Window, Tab, Section = {}, {}, {}
Window.__index, Tab.__index, Section.__index = Window, Tab, Section

-- a drawing + where it sits. org = table with x / y (box or popup origin, window-relative), nil = window origin
function Window:_rec(list, class, props, ox, oy, org, tab, sec)
    local rec = { d = mk(class, props), ox = ox, oy = oy, org = org, tab = tab, sec = sec, v = false, col = props.Color }
    list[#list + 1] = rec
    self:_put(rec)
    self.syncDirty = true
    return rec
end

function Window:_abs(o)
    local org = o.org
    return self.x + (org and org.x or 0) + o.ox, self.y + (org and org.y or 0) + o.oy
end

function Window:_put(rec)
    local x, y = self:_abs(rec)
    rec.d.Position = V2(x, y)
end

function Window:_vis(o)
    if not self.visible or o.hidden then return false end
    if o.fold and not o.fold.open then return false end -- inside a closed fold (see Section:BeginFold)
    if o.tab and self.active ~= o.tab then return false end
    local s = o.sec
    if s and not s:isActive() then return false end
    return true
end

function Window:_refresh(list)
    for i = 1, #list do
        local r = list[i]
        local v = self:_vis(r)
        if v ~= r.v then r.v = v r.d.Visible = v end
    end
end

function Window:_placeList(list)
    for i = 1, #list do self:_put(list[i]) end
end

function Window:_sync()
    self.syncDirty = false
    self:_refresh(self.chrome)
    if self.active then self:_refresh(self.active.recs) end
    if self.popup then self:_refresh(self.popup.recs) end
end

function Window:_removeList(list)
    for i = 1, #list do pcall(function() list[i].d:Remove() end) end
end

function Window:_hit(h)
    self.hits[#self.hits + 1] = h
    return h
end

----------------------------------------------------------------------
-- Popups (dropdown list / colour picker): one at a time, drawn above everything
----------------------------------------------------------------------
function Window:_openPopup(ax, ay, w, h)
    self:_closePopup()
    local p = { org = { x = clamp(ax, 2, self.w - w - 2), y = clamp(ay, 2, self.h - h - 2) }, w = w, h = h, recs = {}, hits = {} }
    self.popup = p
    self:_rec(p.recs, "Square", { Filled = true, Color = T.Panel, Size = V2(w, h), ZIndex = 30 }, 0, 0, p.org)
    self:_rec(p.recs, "Square", { Filled = false, Thickness = 1, Color = T.Accent, Size = V2(w, h), ZIndex = 31 }, 0, 0, p.org)
    return p
end

function Window:_prec(p, class, props, ox, oy)
    return self:_rec(p.recs, class, props, ox, oy, p.org)
end

function Window:_phit(p, h)
    h.org = p.org
    p.hits[#p.hits + 1] = h
    return h
end

function Window:_closePopup()
    local p = self.popup
    if not p then return end
    self.popup = nil
    self.cap = nil
    if self.hover and self.hoverPop then self.hover = nil end
    self:_removeList(p.recs)
    if p.onClose then p.onClose() end
end

----------------------------------------------------------------------
-- Window
----------------------------------------------------------------------
function Lib:CreateWindow(opts)
    opts = opts or {}
    local view = viewSize()
    local win = setmetatable({
        title = opts.Title or "ProjectFuzz | v1.0",
        w = opts.Width or 725, h = opts.Height or 628,
        visible = true, tabs = {}, active = nil, chrome = {}, hits = {}, keybinds = {},
        ver = 0, toggleKey = opts.ToggleKey or 161, syncDirty = true,
    }, Window)
    win.x = opts.X or floor((view.X - win.w) / 2)
    win.y = opts.Y or floor((view.Y - win.h) / 2)
    win.colW = floor((win.w - PAD * 2 - GAP) / 2)

    local C = win.chrome
    win:_rec(C, "Square", { Filled = true, Color = T.Background, Size = V2(win.w, win.h), ZIndex = 1 }, 0, 0)
    win:_rec(C, "Square", { Filled = false, Thickness = 1, Color = Color3.fromRGB(0, 0, 0), Size = V2(win.w + 2, win.h + 2), ZIndex = 2 }, -1, -1)
    win.outlineRec = win:_rec(C, "Square", { Filled = false, Thickness = 1, Color = outlineCol(), Size = V2(win.w, win.h), ZIndex = 2 }, 0, 0)
    win:_rec(C, "Square", { Filled = false, Thickness = 1, Color = T.Inner, Size = V2(win.w - 4, win.h - 4), ZIndex = 2 }, 2, 2)
    -- inner frame: the whole content area under the tabs is its own bordered panel; the boxes sit inside it
    local fy = TABBAR_Y + TABBAR_H + 1
    win:_rec(C, "Square", { Filled = true, Color = T.Frame, Size = V2(win.w - TPAD * 2, win.h - fy - TPAD), ZIndex = 2 }, TPAD, fy)
    win:_rec(C, "Square", { Filled = false, Thickness = 1, Color = T.Border, Size = V2(win.w - TPAD * 2, win.h - fy - TPAD), ZIndex = 3 }, TPAD, fy)
    gradBar(function(c, p, ox, oy) return win:_rec(C, c, p, ox + 1, oy) end, win.w - 2, 1, 40, 3)
    win.titleRec = win:_rec(C, "Text", { Text = U(win.title), Color = T.Text, Font = FONT, Size = 12, ZIndex = 3 }, 8, 5)
    local closeRec = win:_rec(C, "Text", { Text = "X", Color = T.TextDim, Font = FONT, Size = 12, ZIndex = 3 }, win.w - 16, 5)
    win:_rec(C, "Square", { Filled = true, Color = T.Border, Size = V2(win.w - 2, 1), ZIndex = 3 }, 1, TITLE_H)

    -- dragging by the title bar
    win:_hit({ ox = 0, oy = 0, w = win.w - 24, h = TITLE_H,
        onDown = function(mx, my) win:_closePopup() win.dx, win.dy = mx - win.x, my - win.y end,
        onDrag = function(mx, my)
            local v = viewSize()
            local nx = clamp(mx - win.dx, 0, v.X - win.w)
            local ny = clamp(my - win.dy, 0, v.Y - win.h)
            if nx ~= win.x or ny ~= win.y then
                win.x, win.y = nx, ny
                win.ver = win.ver + 1
                win:_placeList(win.chrome)
                if win.active then win:_placeList(win.active.recs) win.active.placedVer = win.ver end
            end
        end })
    win:_hit({ ox = win.w - 22, oy = 0, w = 22, h = TITLE_H,
        onDown = function() win:SetVisible(false) end,
        onHover = function(b) closeRec.d.Color = b and T.Accent or T.TextDim end })

    Lib.Windows[#Lib.Windows + 1] = win
    return win
end

function Window:SetVisible(v)
    self.visible = v and true or false
    if not self.visible then self:_closePopup() end
    for i = 1, #self.tabs do self:_refresh(self.tabs[i].recs) end
    local a = self.active
    if self.visible and a and a.placedVer ~= self.ver then a.dirty = true end
    self:_sync()
end

function Window:Toggle() self:SetVisible(not self.visible) end

function Window:SetTitle(t)
    self.titleRec.d.Text = U(t)
end

function Window:_layoutTabs()
    local n = #self.tabs
    local bw = (self.w - TPAD * 2 - 2 * (n - 1)) / n
    for i = 1, n do
        local t = self.tabs[i]
        local x = TPAD + (i - 1) * (bw + 2)
        t.btn.bg.ox, t.btn.bd.ox, t.btn.txt.ox = x, x, x + bw / 2
        t.btn.bg.d.Size, t.btn.bd.d.Size = V2(bw, TABBAR_H), V2(bw, TABBAR_H)
        t.btn.hit.ox, t.btn.hit.w = x, bw
        self:_put(t.btn.bg) self:_put(t.btn.bd) self:_put(t.btn.txt)
    end
end

function Window:_styleTabs()
    for i = 1, #self.tabs do
        local t = self.tabs[i]
        local on = (t == self.active)
        t.btn.bg.d.Color = on and T.TabActive or T.Panel
        t.btn.txt.d.Color = on and T.White or T.Text
    end
end

function Window:SetTab(tab)
    if self.active == tab then return end
    self:_closePopup()
    local old = self.active
    self.active = tab
    self:_styleTabs()
    if tab.placedVer ~= self.ver then tab.dirty = true end
    if tab.dirty then tab:_reflow() end
    if old then self:_refresh(old.recs) end
    self:_sync()
end

function Window:AddTab(name)
    local tab = setmetatable({ win = self, name = name, recs = {}, boxes = { Left = {}, Right = {} }, dirty = true, placedVer = -1 }, Tab)
    self.tabs[#self.tabs + 1] = tab
    local C = self.chrome
    tab.btn = {
        bg = self:_rec(C, "Square", { Filled = true, Color = T.Panel, Size = V2(10, TABBAR_H), ZIndex = 3 }, 0, TABBAR_Y),
        bd = self:_rec(C, "Square", { Filled = false, Thickness = 1, Color = T.Border, Size = V2(10, TABBAR_H), ZIndex = 4 }, 0, TABBAR_Y),
        txt = self:_rec(C, "Text", { Text = U(name), Color = T.TextDim, Font = FONT, Size = 12, Center = true, ZIndex = 5 }, 0, TABBAR_Y + TABBAR_H / 2),
    }
    tab.btn.hit = self:_hit({ ox = 0, oy = TABBAR_Y, w = 10, h = TABBAR_H,
        onDown = function() self:SetTab(tab) end,
        onHover = function(b) if self.active ~= tab then tab.btn.txt.d.Color = b and T.White or T.Text end end })
    self:_layoutTabs()
    if not self.active then
        self.active = tab
        tab.dirty = true
    end
    self:_styleTabs()
    return tab
end

function Window:Destroy()
    self:_closePopup()
    self:_removeList(self.chrome)
    for i = 1, #self.tabs do self:_removeList(self.tabs[i].recs) end
    for i = #Lib.Windows, 1, -1 do if Lib.Windows[i] == self then table.remove(Lib.Windows, i) end end
end

----------------------------------------------------------------------
-- Tab: two columns of boxes (sections / tabboxes)
----------------------------------------------------------------------
function Tab:_newBox(side, h)
    side = (side == "Right") and "Right" or "Left"
    local box = { tab = self, side = side, x = 0, y = 0, w = self.win.colW, h = h or 30 }
    local col = self.boxes[side]
    col[#col + 1] = box
    self.dirty = true
    return box
end

function Tab:_brec(box, class, props, ox, oy)
    return self.win:_rec(self.recs, class, props, ox, oy, box, self, nil)
end

function Tab:_reflow()
    local win = self.win
    for side, col in pairs(self.boxes) do
        local y = CONTENT_Y
        for i = 1, #col do
            local b = col[i]
            b.x = (side == "Left") and PAD or (PAD + win.colW + GAP)
            b.y = y
            if b.sz ~= b.h then
                b.sz = b.h
                b.bg.d.Size = V2(b.w, b.h)
                b.bd.d.Size = V2(b.w, b.h)
                if b.bd2 then b.bd2.d.Size = V2(b.w - 2, b.h - 2) end
            end
            y = y + b.h + GAP
        end
    end
    win:_placeList(self.recs)
    self.placedVer = win.ver
    self.dirty = false
end

local function newSection(tab, box, cy, sub)
    return setmetatable({ win = tab.win, tab = tab, box = box, cy = cy, sub = sub, folds = {} }, Section)
end

function Section:isActive()
    local b = self.box
    return b.activeSub == nil or b.activeSub == self
end

function Tab:AddSection(title, side)
    local box = self:_newBox(side, 36)
    box.bg = self:_brec(box, "Square", { Filled = true, Color = T.Panel, Size = V2(box.w, 36), ZIndex = 2 }, 0, 0)
    box.bd = self:_brec(box, "Square", { Filled = false, Thickness = 1, Color = T.Border, Size = V2(box.w, 36), ZIndex = 3 }, 0, 0)
    box.bd2 = self:_brec(box, "Square", { Filled = false, Thickness = 1, Color = T.Inner, Size = V2(box.w - 2, 34), ZIndex = 3 }, 1, 1)
    gradBar(function(c, p, ox, oy) return self:_brec(box, c, p, ox, oy) end, box.w, 0, 20, 4)
    self:_brec(box, "Text", { Text = U(title or ""), Color = T.Text, Font = FONT, Size = 12, ZIndex = 5 }, 8, 3)
    return newSection(self, box, 17, false)
end

function Tab:AddTabbox(side)
    local win = self.win
    local box = self:_newBox(side, 38)
    box.subs = {}
    box.bg = self:_brec(box, "Square", { Filled = true, Color = T.Panel, Size = V2(box.w, 38), ZIndex = 2 }, 0, 0)
    box.bd = self:_brec(box, "Square", { Filled = false, Thickness = 1, Color = T.Border, Size = V2(box.w, 38), ZIndex = 3 }, 0, 0)
    box.bd2 = self:_brec(box, "Square", { Filled = false, Thickness = 1, Color = T.Inner, Size = V2(box.w - 2, 36), ZIndex = 3 }, 1, 1)
    gradBar(function(c, p, ox, oy) return self:_brec(box, c, p, ox, oy) end, box.w, 0, 20, 4)
    self:_brec(box, "Square", { Filled = true, Color = T.Border, Size = V2(box.w, 1), ZIndex = 4 }, 0, 20)
    local tb = { box = box }

    local function style()
        for i = 1, #box.subs do
            local s = box.subs[i]
            local on = (box.activeSub == s)
            s.hdrTxt.d.Color = on and T.Accent or T.Text
            s.hdrLine.hidden = not on
        end
        win:_sync()
    end

    function tb:AddTab(name)
        local sec = newSection(self.box.tab, box, 21, true)
        box.subs[#box.subs + 1] = sec
        sec.hdrTxt = self.box.tab:_brec(box, "Text", { Text = U(name), Color = T.TextDim, Font = FONT, Size = 12, Center = true, ZIndex = 5 }, 0, 10)
        sec.hdrLine = self.box.tab:_brec(box, "Square", { Filled = true, Color = T.Accent, Size = V2(10, 2), ZIndex = 5 }, 0, 19)
        sec.hdrLine.hidden = true
        sec.hdrHit = win:_hit({ ox = 0, oy = 2, w = 10, h = 18, org = box, tab = box.tab,
            onDown = function() box.activeSub = sec style() end,
            onHover = function(b) if box.activeSub ~= sec then sec.hdrTxt.d.Color = b and T.White or T.Text end end })
        if not box.activeSub then box.activeSub = sec end
        local n = #box.subs
        local sw = box.w / n
        for i = 1, n do
            local s = box.subs[i]
            s.hdrTxt.ox = (i - 0.5) * sw
            s.hdrLine.ox = (i - 1) * sw + 6
            s.hdrLine.d.Size = V2(sw - 12, 2)
            s.hdrHit.ox, s.hdrHit.w = (i - 1) * sw, sw
        end
        box.tab.dirty = true
        style()
        return sec
    end
    return tb
end

----------------------------------------------------------------------
-- Section helpers
----------------------------------------------------------------------
-- where the section's content ends (rows inside a closed fold take no space)
function Section:_end()
    local e = self.cy
    local fl = self.folds
    for i = 1, #fl do
        if not fl[i].open then e = e - fl[i].h end
    end
    return e
end

function Section:_resize()
    local box = self.box
    if box.subs then
        local m = 0
        for i = 1, #box.subs do
            local e = box.subs[i]:_end()
            if e > m then m = e end
        end
        box.h = m + 10
    else
        box.h = self:_end() + 10
    end
    self.tab.dirty = true
end

function Section:_grow(h)
    local y = self.cy
    self.cy = y + h
    local f = self.fold
    if f then f.h = f.h + h end
    self:_resize()
    return y
end

-- FOLD: a group of rows that can be shown / hidden (the box shrinks and grows with it).
--   local f = sec:BeginFold(false)   -- false = starts closed
--   sec:AddColorPicker(...)          -- everything added until EndFold belongs to the fold
--   sec:EndFold()
--   sec:SetFold(f, true)             -- open / close it (e.g. from a toggle's callback)
-- A fold must be the LAST thing in its section (rows below it would not move up when it closes).
function Section:BeginFold(open)
    local f = { open = (open == true), h = 0 }
    self.fold = f
    self.folds[#self.folds + 1] = f
    return f
end

function Section:EndFold()
    self.fold = nil
end

function Section:SetFold(f, open)
    open = (open == true)
    if not f or f.open == open then return end
    f.open = open
    self.win:_closePopup()
    self:_resize()
    self.win.syncDirty = true
end

function Section:_r(class, props, ox, oy)
    local r = self.win:_rec(self.tab.recs, class, props, ox, oy, self.box, self.tab, self)
    r.fold = self.fold
    return r
end

function Section:_h(h)
    h.org, h.tab, h.sec, h.fold = self.box, self.tab, self, self.fold
    return self.win:_hit(h)
end

-- left indent for rows that live inside a fold
