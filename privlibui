        Circ(o, k .. "3", cx, cy - 3.5, 1, col, a, z, true)
    else
        Rect(o, k .. "1", cx - h + 3, cy - h + 3, s - 6, s - 6, col, a, z, true, 3)
    end
end

--========================================================================
-- Shared controls
--========================================================================
local function SwitchCtl(o, k, sx, cy, on, z)
    local sw, sh = 34, 18
    local sy = cy - sh / 2
    local hv = hot(sx, sy, sw, sh)
    local t = ani(o, k .. "t", on and 1 or 0, 16)
    local h = ani(o, k .. "h", hv and 1 or 0, 14)
    Rect(o, k .. "a", sx, sy, sw, sh, mix(mix(C.track, C.text, h * 0.08), C.accent, t), 1, z, true, sh / 2)
    Circ(o, k .. "b", sx + sh / 2 + (sw - sh) * t, cy, 6.2 + h * 0.7, mix(C.accent, C.white, t), 1, z + 2, true)
    return hv
end

local function Segmented(o, k, x, cy, w, h, opts, sel, z)
    local y = cy - h / 2
    Box2(o, k .. "bg", x, y, w, h, C.bg, C.border, 1, z, 6)
    local sw = (w - 4) / #opts
    local tx = ani(o, k .. "x", x + 2 + (sel - 1) * sw, 18)
    Rect(o, k .. "th", tx, y + 2, sw, h - 4, C.accent, 1, z + 2, true, 4)
    local res
    for i, name in ipairs(opts) do
        local ix = x + 2 + (i - 1) * sw
        local hv = hot(ix, y, sw, h)
        if hv and M.pressed then res = i end
        local hh = ani(o, k .. "h" .. i, hv and 1 or 0, 14)
        local col = (i == sel) and C.white or mix(C.dim, C.text, hh)
        Txt(o, k .. "t" .. i, name, ix + sw / 2, cy, col, 1, z + 4, 11.5, true, "c")
    end
    return res
end

local function Button(o, k, x, y, w, h, label, z)
    local hv = hot(x, y, w, h)
    local hh = ani(o, k .. "h", hv and 1 or 0, 16)
    local pr = ani(o, k .. "p", (hv and M.down) and 1 or 0, 26)
    local fill = mix(mix(C.group, C.text, 0.04 + 0.05 * hh), C.accent, 0.25 * pr)
    Box2(o, k .. "bx", x, y + pr, w, h, fill, mix(C.border, C.accent, hh * 0.7), 1, z, 6)
    Txt(o, k .. "t", label, x + w / 2, y + h / 2 + pr, mix(C.dim, C.text, max(hh, 0.6)), 1, z + 3, 12, true, "c")
    return hv and M.pressed
end

local function IconBtn(o, k, icon, x, y, w, h, z)
    local hv = hot(x, y, w, h)
    local ha = ani(o, k .. "h", hv and 1 or 0, 16)
    Box2(o, k .. "bx", x, y, w, h, mix(C.group, C.text, 0.03 + 0.07 * ha), mix(C.border, C.accent, ha * 0.6), 1, z, 5)
    Icon(o, k .. "i", icon, x + w / 2, y + h / 2, 12, mix(C.dim, C.text, ha), 1, z + 2)
    return hv and M.pressed
end

local function KeyPillCtl(o, k, x, y, w, h, txt, listening, z)
    local hv = hot(x, y, w, h)
    local ha = ani(o, k .. "h", hv and 1 or 0, 16)
    local la = ani(o, k .. "l", listening and 1 or 0, 16)
    Box2(o, k .. "bx", x, y, w, h, mix(C.bg, C.hover, ha * 0.5), mix(C.border, C.accent, max(la, ha * 0.5)), 1, z, 5)
    Txt(o, k .. "t", txt, x + w / 2, y + h / 2, mix(C.text, C.accent, la), 1, z + 2, 12, true, "c")
    return hv and M.pressed
end

--========================================================================
-- Popups (dropdowns, bind settings, popovers)
--========================================================================
local POPD = {}
local function openPop(kind, f)
    local o = POPD[kind]
    if not o then o = { kind = kind }; POPD[kind] = o end
    o.__a = { __h = 24, __t = 0 }
    o.closing = false
    o.born = frameId
    for k, v in pairs(f) do o[k] = v end
    POP = o
end
local function closePop() if POP and not POP.closing then POP.closing = true end end

local MODES = { "Toggle", "Hold", "Off" }
local function modeIndex(m) for i, v in ipairs(MODES) do if v == m then return i end end return 1 end

local function dropContent(p, x, y, z)
    local w = p.owner
    for i, name in ipairs(w.items) do
        local ry = y + 4 + (i - 1) * 24
        local hv = hot(x + 3, ry, p.w - 6, 24)
        local ha = ani(p, "h" .. i, hv and 1 or 0, 20)
        local sel = w.multi and w.set[name] or (not w.multi and w.value == i)
        local sa = ani(p, "s" .. i, sel and 1 or 0, 16)
        if ha > 0.01 then Rect(p, "hv" .. i, x + 3, ry, p.w - 6, 24, C.hover, ha, z, true, 5) end
        if w.multi then
            Box2(p, "cb" .. i, x + 10, ry + 5, 14, 14, mix(C.bg, C.accent, sa), mix(C.border, C.accent, sa), 1, z + 1, 4)
            if sa > 0.05 then Icon(p, "ck" .. i, "check", x + 17, ry + 12, 12, C.white, sa, z + 4) end
            Txt(p, "t" .. i, name, x + 32, ry + 12, C.text, 1, z + 2, 12.5, true)
        else
            if sa > 0.01 then Rect(p, "bar" .. i, x + 5, ry + 5, 2.5, 14, C.accent, sa, z + 1, true, 1) end
            Txt(p, "t" .. i, name, x + 16 + 2 * sa, ry + 12, C.text, 1, z + 2, 12.5, true)
        end
        if hv and M.pressed and p.born ~= frameId then
            w:pick(i)
            if not w.multi then p.closing = true end
        end
    end
end

local function subContent(p, x, y, z)
    local ow = p.owner
    Txt(p, "t", ow.title, x + 12, y + 20, C.text, 1, z, 13.5, true)
    Ln(p, "sep", x + 10, y + 36, x + p.w - 10, y + 36, C.border, 1, z, 1)
    local cy = y + 42
    for _, r in ipairs(ow.sub.rows) do
        r:draw(x + 12, cy, p.w - 24, z + 2)
        cy = cy + r.h
    end
end

local function bindContent(p, x, y, z)
    local it, bw = p.owner, p.w
    Txt(p, "ti", "Bind Settings", x + 14, y + 20, C.text, 1, z, 13.5, true)
    local by = y + 40
    local i = 1
    while i <= #it.binds do
        local b = it.binds[i]
        local k = "b" .. i
        Txt(p, k .. "h", "Bind " .. i, x + 14, by + 14, C.text, 1, z, 12.5, true)
        if IconBtn(p, k .. "d", "trash", x + bw - 36, by + 3, 22, 22, z) then table.remove(it.binds, i); break end
        local ky = by + 28
        Txt(p, k .. "kl", "Key", x + 14, ky + 14, C.text, 1, z, 12, false)
        local listening = CAP and CAP.owner == b
        if KeyPillCtl(p, k .. "kp", x + bw - 14 - 22 - 6 - 64, ky + 3, 64, 22, listening and "..." or keyName(b.vk), listening, z) then
            startCapture(b, function(vk) b.vk = vk; b.last = false end)
        end
        if IconBtn(p, k .. "ke", "x", x + bw - 36, ky + 3, 22, 22, z) then b.vk = 0 end
        local my = by + 56
        Txt(p, k .. "ml", "Mode", x + 14, my + 14, C.text, 1, z, 12, false)
        local r = Segmented(p, k .. "m", x + bw - 14 - 138, my + 14, 138, 22, MODES, modeIndex(b.mode), z)
        if r then b.mode = MODES[r] end
        local sy = by + 84
        Txt(p, k .. "sl", "Show in list", x + 14, sy + 14, C.text, 1, z, 12, false)
        if SwitchCtl(p, k .. "sw", x + bw - 14 - 34, sy + 14, b.show, z) and M.pressed then b.show = not b.show end
        by = by + 120
        i = i + 1
    end
    if Button(p, "add", x + 14, by - 2, bw - 28, 24, "+ Add bind", z) then
        it.binds[#it.binds + 1] = { vk = 0, mode = "Toggle", show = true, last = false }
    end
end

local openDrop, openBindPop, openSubPop, openSwatchPop
openDrop = function(w, x, y, cw)
    openPop("drop", { owner = w, x = x, y = y, w = cw, content = dropContent,
        measure = function(p) return #p.owner.items * 24 + 8 end })
end
openBindPop = function(item, ax, ay)
    openPop("bind", { owner = item, x = ax - 190, y = ay + 6, w = 216, content = bindContent,
        measure = function(p) return 40 + #p.owner.binds * 120 + 34 end })
end
openSubPop = function(item, ax, ay)
    openPop("sub", { owner = item, x = ax, y = ay, w = item.pw or 200, content = subContent,
        measure = function(p)
            local h = 48
            for _, r in ipairs(p.owner.sub.rows) do h = h + r.h end
            return h
        end })
end

--========================================================================
-- Widget kinds
--========================================================================
local Kinds = {}
for _, k in ipairs({ "switch", "slider", "choice", "multi", "popover", "keypill", "entry", "buttons", "themes", "caption" }) do
    Kinds[k] = {}
    Kinds[k].mt = { __index = Kinds[k] }
end
local function newItem(kind, t) t.kind = kind; return setmetatable(t, Kinds[kind].mt) end

-- Switch ---------------------------------------------------------------
function Kinds.switch.Get(w) return w.value end
function Kinds.switch.Set(w, v) w.value = v and true or false; if w.callback then w.callback(w.value) end end
function Kinds.switch.draw(w, x, y, wd, z)
    local cy = y + 13
    Txt(w, "l", w.label, x, cy, w.dim and C.dim or C.text, 1, z, 12.5, not w.dim)
    local sx = x + wd - 34
    if SwitchCtl(w, "s", sx, cy, w.value, z) and M.pressed then w:Set(not w.value) end
    local rx = sx - 8
    if w.color then
        local sh = hot(rx - 16, cy - 8, 16, 16)
        local ha = ani(w, "swh", sh and 1 or 0, 14)
        Rect(w, "swb", rx - 16 - ha, cy - 8 - ha, 16 + 2 * ha, 16 + 2 * ha, C.border, 1, z, true, 5)
        Rect(w, "swc", rx - 15, cy - 7, 14, 14, w.color, 1, z + 2, true, 4)
        if sh and M.pressed then openSwatchPop(w, rx - 16, cy + 10) end
        rx = rx - 24
    end
    if w.bindable then
        local bx = rx - 22
        local bh = hot(bx, cy - 10, 22, 20)
        local ha = ani(w, "bdh", bh and 1 or 0, 14)
        Rect(w, "bdbg", bx, cy - 10, 22, 20, C.hover, ha, z, true, 5)
        local col = mix(C.dim, C.text, ha)
        for i = -1, 1 do Circ(w, "bd" .. i, bx + 11 + i * 5, cy, 1.5, col, 1, z + 2, true) end
        if bh and M.pressed then openBindPop(w, bx, cy + 10) end
    end
end

-- Slider ---------------------------------------------------------------
local function snap(w, v)
    if w.step and w.step > 0 then v = floor(v / w.step + 0.5) * w.step end
    return clamp(v, w.min, w.max)
end
function Kinds.slider.Get(w) return w.value end
function Kinds.slider.Set(w, v) w.value = snap(w, v); if w.callback then w.callback(w.value) end end
function Kinds.slider.draw(w, x, y, wd, z)
    local cy = y + 13
    Txt(w, "l", w.label, x, cy, C.text, 1, z, 12.5, true)
    if w.dot then
        Circ(w, "dot", x + tw(w.label, 12.5) + 9, cy + 0.5, 2.6, C.accent, 0.55 + 0.45 * sin(tick() * 3), z, true)
    end
    local v = w.value
    local isOff = w.zeroText and v <= w.min
    local txt = isOff and w.zeroText or string.format("%." .. (w.dec or 0) .. "f%s", v, w.suffix or "")
    local pw = max(46, tw(txt, 11.5) + 14)
    local px_ = x + wd - pw
    local phv = hot(px_, cy - 9, pw, 18)
    local drag = (dragOwner == w)
    if not w.noTrack then
        local tx0 = x + (w.trackX or 104)
        local tx1 = px_ - 12
        local len = tx1 - tx0
        local hv = hot(tx0 - 5, cy - 9, len + 10, 18)
        if hv and M.pressed and not dragOwner then dragOwner = w; drag = true end
        if dragOwner == w then
            if M.down then w:Set(w.min + (w.max - w.min) * clamp((M.x - tx0) / len, 0, 1)) else dragOwner = nil; drag = false end
        end
        local frac = (w.value - w.min) / (w.max - w.min)
        local fa = ani(w, "f", frac, 22)
        local act = ani(w, "a", (hv or drag) and 1 or 0, 16)
        Rect(w, "tr", tx0, cy - 1.5, len, 3, C.track, 1, z, true, 1.5)
        Rect(w, "fl", tx0, cy - 1.5, max(0, len * fa), 3, C.accent, 1, z + 1, true, 1.5)
        Circ(w, "kn", tx0 + len * fa, cy, 4 + act * 1.4, C.knob, 1, z + 2, true)
    else
        if phv and M.pressed and not dragOwner then dragOwner = w; drag = true; w.dx0 = M.x; w.dv0 = w.value end
        if dragOwner == w then
            if M.down then w:Set(w.dv0 + (M.x - w.dx0) * (w.max - w.min) / 140) else dragOwner = nil; drag = false end
        end
    end
    local pa = ani(w, "pa", isOff and 0 or 1, 12)
    local ph = ani(w, "ph", (phv or drag) and 1 or 0, 14)
    Box2(w, "pl", px_, cy - 9, pw, 18, mix(C.group, C.accent, 0.12 * pa + 0.05 * ph), mix(C.border, C.accent, max(pa * 0.9, ph * 0.6)), 1, z, 5)
    Txt(w, "pv", txt, px_ + pw / 2, cy, mix(C.dim, C.accent, pa), 1, z + 2, 11.5, true, "c")
end

-- Choice (single dropdown) ---------------------------------------------
function Kinds.choice.Get(w) return w.items[w.value] end
function Kinds.choice.Set(w, i) w:pick(i) end
function Kinds.choice.pick(w, i) w.value = i; if w.callback then w.callback(i, w.items[i]) end end
function Kinds.choice.Text(w) return w.items[w.value] or "" end

local function dropCtl(w, x, y, wd, z)
    local H_ = w.bare and 20 or 26
    local cy = y + H_ / 2
    if not w.bare then Txt(w, "l", w.label, x, cy, C.text, 1, z, 12.5, true) end
    local cw = w.cw
    local cx = w.bare and x or (x + wd - cw)
    local chh = 20
    local top = cy - chh / 2
    local isOpen = POP and POP.owner == w and not POP.closing
    local hv = hot(cx, top, cw, chh)
    local ha = ani(w, "h", hv and 1 or 0, 14)
    local oa = ani(w, "o", isOpen and 1 or 0, 16)
    Box2(w, "bx", cx, top, cw, chh, mix(C.bg, C.hover, ha * 0.6), mix(C.border, C.accent, max(oa, ha * 0.4)), 1, z, 5)
    Txt(w, "v", fit(w:Text(), cw - 26, 12), cx + 8, cy, C.text, 1, z + 2, 12, false)
    local ccx, d = cx + cw - 11, 1 - 2 * oa
    local col = mix(C.dim, C.text, max(ha, oa))
    Ln(w, "c1", ccx - 3.5, cy - 1.5 * d, ccx, cy + 1.5 * d, col, 1, z + 2, 1.4)
    Ln(w, "c2", ccx, cy + 1.5 * d, ccx + 3.5, cy - 1.5 * d, col, 1, z + 2, 1.4)
    if hv and M.pressed then openDrop(w, cx, top + chh + 4, cw) end
end
Kinds.choice.draw = dropCtl

-- Multi dropdown -------------------------------------------------------
function Kinds.multi.Get(w) return w.set end
function Kinds.multi.Set(w, v) w.set = v end
function Kinds.multi.pick(w, i)
    local n = w.items[i]
    w.set[n] = not w.set[n] or nil
    if w.callback then w.callback(w.set) end
end
function Kinds.multi.Text(w)
    local t = {}
    for _, n in ipairs(w.items) do if w.set[n] then t[#t + 1] = n end end
    return #t > 0 and table.concat(t, ", ") or "None"
end
Kinds.multi.draw = dropCtl

-- Popover trigger (>> button) ----------------------------------------
function Kinds.popover.draw(w, x, y, wd, z)
    local cy = y + 13
    Txt(w, "l", w.label, x, cy, C.dim, 1, z, 12.5, false)
    local bx, bw, bh = x + wd - 36, 36, 18
    local hv = hot(bx, cy - 9, bw, bh)
    local isOpen = POP and POP.owner == w and not POP.closing
    local ha = ani(w, "h", hv and 1 or 0, 14)
    local oa = ani(w, "o", isOpen and 1 or 0, 14)
    Box2(w, "bx", bx, cy - 9, bw, bh, mix(C.bg, C.accent, 0.1 * oa + 0.05 * ha), mix(C.border, C.accent, max(oa, ha * 0.6)), 1, z, 5)
    local col = mix(C.dim, C.accent, max(oa, ha))
    for i = 0, 1 do
        local ox_ = bx + bw / 2 - 3 + i * 5
        Ln(w, "a" .. i, ox_ - 1.5, cy - 3.5, ox_ + 1.5, cy, col, 1, z + 2, 1.5)
        Ln(w, "b" .. i, ox_ + 1.5, cy, ox_ - 1.5, cy + 3.5, col, 1, z + 2, 1.5)
    end
    if hv and M.pressed then openSubPop(w, bx + bw + 8, cy - 16) end
end

-- Key pill -----------------------------------------------------------
function Kinds.keypill.Get(w) return w.value end
function Kinds.keypill.Set(w, v) w.value = v; if w.callback then w.callback(v) end end
function Kinds.keypill.draw(w, x, y, wd, z)
    local cy = y + 13
    Txt(w, "l", w.label, x, cy, w.dim and C.dim or C.text, 1, z, 12.5, not w.dim)
    local listening = CAP and CAP.owner == w
    local txt = listening and "..." or keyName(w.value)
    local pw = max(34, tw(txt, 12) + 18)
    if KeyPillCtl(w, "p", x + wd - pw, cy - 11, pw, 22, txt, listening, z) then
        startCapture(w, function(vk) w:Set(vk) end)
    end
end

-- Text entry -----------------------------------------------------------
function Kinds.entry.Get(w) return w.text end
function Kinds.entry.Set(w, v) w.text = v end
function Kinds.entry.draw(w, x, y, wd, z)
    Txt(w, "l", w.label, x, y + 9, C.text, 1, z, 12.5, true)
    local fy, fh = y + 20, 28
    local hv = hot(x, fy, wd, fh)
    if hv then w.hovFrame = frameId end
    if hv and M.pressed then focusText(w) end
    local foc = (TI.owner == w)
    local fa = ani(w, "f", foc and 1 or 0, 16)
    local ha = ani(w, "h", hv and 1 or 0, 14)
    Box2(w, "bx", x, fy, wd, fh, mix(C.bg, C.hover, ha * 0.4), mix(C.border, C.accent, max(fa, ha * 0.3)), 1, z, 6)
    if w.text == "" and not foc then
        Txt(w, "ph", w.placeholder or "", x + 10, fy + fh / 2, C.dim, 1, z + 2, 12.5, false)
    else
        Txt(w, "tx", w.text, x + 10, fy + fh / 2, C.text, 1, z + 2, 12.5, false)
    end
    if foc and floor(tick() * 2) % 2 == 0 then
        Rect(w, "car", x + 11 + tw(w.text, 12.5), fy + 7, 1, fh - 14, C.text, 1, z + 3, true, 0)
    end
end

-- Buttons grid ---------------------------------------------------------
function Kinds.buttons.draw(w, x, y, wd, z)
    local gap, rh = 6, 28
    local colw = (wd - gap) / 2
    local col, ry, idx = 0, y + 2, 1
    while idx <= #w.list do
        local b = w.list[idx]
        if b.full then
            if col ~= 0 then col = 0; ry = ry + rh + gap end
            if Button(w, "b" .. idx, x, ry, wd, rh, b[1], z) and b[2] then b[2]() end
            ry = ry + rh + gap
        else
            if Button(w, "b" .. idx, x + col * (colw + gap), ry, colw, rh, b[1], z) and b[2] then b[2]() end
            col = col + 1
            if col == 2 then col = 0; ry = ry + rh + gap end
        end
        idx = idx + 1
    end
end

-- Theme list -----------------------------------------------------------
function Kinds.themes.Get(w) return THEMES[w.value].name end
function Kinds.themes.Set(w, i)
    w.value = i
    applyTheme(THEMES[i].name)
    if w.callback then w.callback(THEMES[i].name) end
end
function Kinds.themes.draw(w, x, y, wd, z)
    Txt(w, "l", "Theme", x, y + 13, C.text, 1, z, 12.5, true)
    Txt(w, "v", THEMES[w.value].name, x + wd, y + 13, C.text, 1, z, 12.5, true, "r")
    local ly, lh = y + 30, #THEMES * 22 + 8
    Box2(w, "lb", x, ly, wd, lh, C.bg, C.border, 1, z, 6)
    local hy = ani(w, "hy", (w.value - 1) * 22, 16)
    Rect(w, "hl", x + 3, ly + 4 + hy, wd - 6, 22, C.sel, 1, z + 2, true, 4)
    Rect(w, "bar", x + 3, ly + 8 + hy, 2.5, 14, C.accent, 1, z + 3, true, 1)
    for i, t in ipairs(THEMES) do
        local ry = ly + 4 + (i - 1) * 22
        local hv = hot(x + 3, ry, wd - 6, 22)
        local ha = ani(w, "h" .. i, hv and 1 or 0, 14)
        if hv and M.pressed then w:Set(i) end
        local sel = (w.value == i)
        local sa = ani(w, "s" .. i, sel and 1 or 0, 14)
        if ha > 0.02 and not sel then Rect(w, "hv" .. i, x + 3, ry, wd - 6, 22, C.hover, ha, z + 1, true, 4) end
        Txt(w, "t" .. i, t.name, x + 14 + 14 * sa, ry + 11, mix(C.dim, C.text, max(sa, ha)), 1, z + 4, 12, sel)
        if sa > 0.02 then
            Tri(w, "ar" .. i, x + 13, ry + 7, x + 13, ry + 15, x + 20, ry + 11, C.accent, sa, z + 4)
        end
    end
end

-- Caption --------------------------------------------------------------
function Kinds.caption.measure(w, wd)
    w.lines = wrap(w.text, wd, 12)
    w.h = #w.lines * 16 + 8
end
function Kinds.caption.draw(w, x, y, wd, z)
    for i, l in ipairs(w.lines or {}) do Txt(w, "c" .. i, l, x, y + 8 + (i - 1) * 16, C.dim, 1, z, 12, false) end
end

--========================================================================
-- Box / Page API
--========================================================================
local BoxAPI = {}
BoxAPI.__index = BoxAPI
local function newBox(hub, title, side) return setmetatable({ hub = hub, title = title or "", side = side or "Left", rows = {} }, BoxAPI) end
local function addRow(box, w)
    w.box = box; w.hub = box.hub
    box.rows[#box.rows + 1] = w
    if w.id and box.hub then box.hub.items[w.id] = w end
    if w.bindable and box.hub then box.hub.bindList[#box.hub.bindList + 1] = w end
    return w
end

function BoxAPI:Switch(id, label, default, opts)
    opts = opts or {}
    local w = newItem("switch", { id = id, label = label, value = default or false, dim = opts.dim, bold = opts.bold,
        callback = opts.callback, h = 26, binds = {}, bindable = (opts.bind or opts.binds) and true or false })
    if opts.color then w.color = { opts.color.R, opts.color.G, opts.color.B } end
    for _, b in ipairs(opts.binds or {}) do w.binds[#w.binds + 1] = { vk = b.key or 0, mode = b.mode or "Toggle", show = b.show ~= false, last = false } end
    return addRow(self, w)
end
function BoxAPI:Slider(id, label, mn, mx, default, opts)
    opts = opts or {}
    local w = newItem("slider", { id = id, label = label, min = mn, max = mx, value = default or mn, suffix = opts.suffix,
        dec = opts.dec or 0, step = opts.step or (opts.dec and 10 ^ -opts.dec or 1), zeroText = opts.zeroText, dot = opts.dot,
        noTrack = opts.noTrack, trackX = opts.trackX, callback = opts.callback, h = 26 })
