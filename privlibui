        Circ(o, k .. "1", cx, cy, h - 3, col, a, z, false, 2.2)
        Circ(o, k .. "2", cx, cy, 1.6, col, a, z, true)
        Ln(o, k .. "3", cx, cy - h + 1, cx, cy - h + 3, col, a, z, 2)
