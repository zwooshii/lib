-- ProjectFuzz: library + demo in ONE file (paste into Matcha and run)
local Lib = (function()
--[[
    ProjectFuzz UI Library  -  for Matcha LuaVM (Drawing API)
    ---------------------------------------------------------
    Retained-mode: every drawing is created once, positions are only rewritten
    when something moves, Visible / Color / Text are only written when they change.

    local Lib = loadstring(readfile("ProjectFuzz.lua"))()
    local Win = Lib:CreateWindow({ Title = "ProjectFuzz | v1.0", Width = 725, Height = 560, ToggleKey = 161 })
    local Tab = Win:AddTab("Main")
    local Sec = Tab:AddSection("Section", "Left")           -- "Left" or "Right"
    local T   = Sec:AddToggle("id", "Label", false, function(v) end)
    T:AddKeybind("id_kb", 0, "Toggle")                       -- addons sit on the right of the row
    T:AddColorPicker("id_col", Color3.fromRGB(255,255,255))
    Sec:AddSlider("id", "Label", 0, 100, 50, { Suffix = "%", Decimals = 0, ShowMax = true, Callback = fn })
    Sec:AddDropdown("id", "Label", {"A","B"}, "A", fn, false) -- last arg = multi select
    Sec:AddButton("Label", fn) / Sec:AddLabel("text") / Sec:AddKeybind(...) / Sec:AddColorPicker(...) / Sec:AddSpacing(n)
    local Box = Tab:AddTabbox("Right"); local Sub = Box:AddTab("Aim")  -- Sub is used like a section
    Lib.Flags.id                                              -- current value of any widget
    Lib.Objects.id:Set(v) / :Get()
    Lib:Notify("Title", "Text", 5)
    Lib:SaveConfig("name") / Lib:LoadConfig("name")
    Sec:BeginFold(false) ... Sec:EndFold() / Sec:SetFold(f, bool)  -- rows that show/hide (indented while inside)
    Lib:SetGradient(bool)                                     -- flat colour (default) or gradient
    Lib:Unload()
]]

