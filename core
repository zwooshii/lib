function Lime:Tag(text, col)
    if typeof(col) == "Color3" then col = { col.R, col.G, col.B } end
    local t = { text = string.upper(tostring(text)), col = col or { 1, 1, 1 } }
    self.tags[#self.tags + 1] = t
