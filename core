function Lime:Init()
    if self.initialized then return self end
    self.initialized = true
    self:_BuildCommon()
    self:CfgInit()                          -- fills the Saved list, applies the autoload config, takes the unsaved-changes baseline
    self:Select(self.pages[1])              -- first page the script created
    hookWheel(self)
    self:Run()
    self:LoadIcons()
    return self
end

-- true while a feature is really on: the switch is enabled AND, when it has binds, a bind is active
-- (Toggle bind = the switch itself, Hold bind = key currently held, "Off" binds are ignored).
function Lime:IsActive(id)
    local it = self.items[id]
    if not it or not it.value then return false end
    local any, active = false, false
    for _, b in ipairs(it.binds or {}) do
        if b.mode ~= "Off" then
            any = true
            if bindActive(it, b) then active = true end
        end
    end
    return (not any) or active
end

