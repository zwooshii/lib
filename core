--========================================================================
-- Debug: live performance readout (Common > Debug). Costs nothing unless that page is open.
--========================================================================
-- Scripts can add their own lines:  Window:DebugStat("Panels", function() return "12 drawings" end)
-- Scripts can add a box to the Debug page:  Window:DebugBox(function(page) page:AddBox("Mine", "Left") ... end)
function Lime:DebugBox(fn)
    self.dbgQueue = self.dbgQueue or {}
    self.dbgQueue[#self.dbgQueue + 1] = fn
end
function Lime:DebugStat(name, fn)
    for _, e in ipairs(self.dbgExt) do if e[1] == name then e[2] = fn; return end end
    self.dbgExt[#self.dbgExt + 1] = { name, fn }
end

local function setRow(rows, i, label, value, col)
    local r = rows[i]
    if not r then r = {}; rows[i] = r end
    r[1], r[2], r[3] = label, value, col
end
local function trimRows(rows, n) for i = #rows, n + 1, -1 do rows[i] = nil end end
local DBG_KINDS = { "Square", "Text", "Circle", "Line", "Triangle", "Image" }

-- rebuilds the three readouts at most 4 times a second
function Lime:DebugTick(now)
    local prev = self.dbgAt
    if prev and now - prev < 0.25 then return end
    local span = prev and (now - prev) or 0.25
    self.dbgAt = now

    -- Lua memory + how much garbage is being created per second (sum of the increases between samples)
    local okm, kb = pcall(collectgarbage, "count")
    if okm and type(kb) == "number" then
        if self.dbgKb and kb > self.dbgKb then self.dbgAlloc = (self.dbgAlloc or 0) + (kb - self.dbgKb) end
        self.dbgKb = kb
        self.dbgWin = (self.dbgWin or 0) + span
        if self.dbgWin >= 1 then
            self.dbgRate = (self.dbgAlloc or 0) / self.dbgWin
            self.dbgAlloc, self.dbgWin = 0, 0
        end
    end

    local ms = self.frameMs
    local msCol = ms < 3 and C.accent or (ms < 6 and WARN or RED)
    local fpsCol = self.fps >= 50 and C.accent or (self.fps >= 30 and WARN or RED)
    local n = 0
    local rows = self.dbgPerf.rows
    n = n + 1; setRow(rows, n, "FPS", string.format("%d", floor(self.fps + 0.5)), fpsCol)
    n = n + 1; setRow(rows, n, "Script time / frame", string.format("%.2f ms  (peak %.2f)", ms, self.peakMs), msCol)
    n = n + 1; setRow(rows, n, "Drawings visible", shownN .. " / " .. liveN)
    n = n + 1; setRow(rows, n, "Property writes / frame", string.format("%.0f", self.wrAvg))
    if okm and type(kb) == "number" then
        n = n + 1; setRow(rows, n, "Lua memory", string.format("%.2f MB", kb / 1024))
        n = n + 1; setRow(rows, n, "Garbage created", string.format("%.0f KB/s", self.dbgRate or 0))
    end
    n = n + 1; setRow(rows, n, "Mode", PERF and "Performance Mode" or "Normal")
    trimRows(rows, n)

    rows, n = self.dbgPool.rows, 0
    for _, k in ipairs(DBG_KINDS) do
        n = n + 1; setRow(rows, n, k .. "s", tostring(KINDN[k] or 0))
    end
    local items = 0
    for _ in pairs(self.items) do items = items + 1 end
    n = n + 1; setRow(rows, n, "Pool entries", #pool .. (deadCount > 0 and ("  (" .. deadCount .. " removed)") or ""))
    n = n + 1; setRow(rows, n, "Widgets / pages", items .. " / " .. #self.pages)
    n = n + 1; setRow(rows, n, "Text width cache", TWN .. " + " .. FITN)
    trimRows(rows, n)

    rows, n = self.dbgScripts.rows, 0
    for _, e in ipairs(self.dbgExt) do
        local ok, v = pcall(e[2])
        n = n + 1; setRow(rows, n, e[1], ok and tostring(v) or "error")
    end
    if n == 0 then n = 1; setRow(rows, 1, "No script lines yet", "") end
    trimRows(rows, n)
end

function Lime:DebugReport()
    self.dbgAt = nil
    self:DebugTick(tick())
    local out = { "fzzr " .. self.version .. " debug report" }
    for _, sec in ipairs({ { "Performance", self.dbgPerf }, { "Drawing pool", self.dbgPool }, { "Scripts", self.dbgScripts } }) do
        out[#out + 1] = "[" .. sec[1] .. "]"
        for _, r in ipairs(sec[2].rows) do out[#out + 1] = r[1] .. ": " .. r[2] end
    end
    return table.concat(out, "\n")
end

local function drawBox(box, x, y, wd, z, enter)
    local rows = box.rows
    local bh = 16
    for i = 1, #rows do
        local r = rows[i]
        if r.measure then r:measure(wd - 20) end
        bh = bh + r.h
    end
    local total = 18 + bh + 10
    -- entirely outside the visible area: nothing to draw (the end-of-frame sweep hides it)
    if CLIP0 and (y + total < CLIP0 or y > CLIP1) then return total end
    if box.titleSrc ~= box.title then box.titleSrc = box.title; box.titleUp = string.upper(box.title) end
    Txt(box, "title", box.titleUp, x + 2, y + 8, C.dim, 1, z, 10.5, true)
    -- hover: the border fades toward the accent colour while the mouse is over the box
    local hv = hot(x, y + 18, wd, bh)
    local hh = ani(box, "bhov", hv and 1 or 0, 10)
    Box2(box, "bg", x, y + 18, wd, bh, C.group, mix(C.border, C.accent, hh * 0.4), 1, z, 7)
    local cy = y + 18 + 8
    local save = GA
    GA = GA * (enter or 1)           -- contents lag the frame during the page fade-in
    local hq = box.hub and box.hub.query
    if hq == "" then hq = nil end
    for i = 1, #rows do
        local r = rows[i]
        if not CLIP0 or dragOwner == r or (cy + r.h >= CLIP0 and cy <= CLIP1) then
            -- search: tint the matching part of the label (drawn under the label text)
            if hq and r.label then
                local s, e = r.label:lower():find(hq:lower(), 1, true)
                if s then
                    Rect(r, "hlq", x + 10 + tw(r.label:sub(1, s - 1), 12.5) - 2, cy + r.h / 2 - 8,
                        tw(r.label:sub(s, e), 12.5) + 4, 16, C.accent, 0.24, z + 3, true, 3)
                end
            end
            r:draw(x + 10, cy, wd - 20, z + 4)
            if r.tip and hot(x + 10, cy, wd - 20, r.h) then TIPC = r end     -- hover tooltip candidate
        end
        cy = cy + r.h
    end
    GA = save
    return total
end

local function searchBoxes(hub)
    if hub.sq == hub.query and hub.sres then return hub.sres end
    hub.sq = hub.query
    local q, out = hub.query:lower(), {}
    for _, p in ipairs(hub.pages) do
        if #p.children == 0 then
            for _, box in ipairs(p.boxes) do
                local rows = {}
                for _, r in ipairs(box.rows) do
                    if r.label and r.label:lower():find(q, 1, true) then rows[#rows + 1] = r end
                end
                if #rows > 0 then
                    local px_ = box.proxy
                    if not px_ then px_ = { hub = hub, side = "auto" }; box.proxy = px_ end
                    px_.title = p.name .. " / " .. box.title
                    px_.rows = rows
                    out[#out + 1] = px_
                end
            end
        end
    end
    hub.sres = out
    hub.clock = 0
    return out
end

-- The page list scrolls inside this band: it ends just above the footer separator line (user + ping)
local SIDE_TOP, SIDE_BOT = 66, H - 64      -- list area: strictly between the logo/version block and the footer
local function sideRow(hub, p, y, h, alpha, child)
    -- rows fade out as they approach either cut edge, so none is ever left half-drawn
    local mid = y + h / 2
    alpha = alpha * clamp((SIDE_BOT - mid - 6) / 14, 0, 1) * clamp((mid - SIDE_TOP - 6) / 14, 0, 1)
    local hv = hot(8, y, SW - 16, h)
    if hv and M.pressed and alpha > 0.5 then hub:Select(p) end
    local ha = ani(p, "hv", hv and 1 or 0, 14)
    local act = (hub.active == p) or (hub.active and hub.active.parent == p)
    local ia = ani(p, "act", act and 1 or 0, 14)
    local tcol = mix(mix(C.dim, C.text, ha * 0.7), C.text, ia)
    local ix = child and 36 or 26
    Icon(p, "i", p.icon or "file", ix, y + h / 2, child and 14 or 16, tcol, alpha, 17)
    Txt(p, "t", p.name, ix + 16, y + h / 2, tcol, alpha, 17, 13, true)
end

local function drawSidebar(hub)
    local sa = ani(hub, "side", hub.sideT or 0, 16)       -- animated scroll offset of the list
    local y, ty, th = SIDE_TOP + 4 - sa, nil, nil
    CLIP0, CLIP1 = SIDE_TOP, SIDE_BOT
    local ap = hub.alertPage                -- page the unsaved-changes "!" leads to (Configs)
    local apParentY, apParentE, apChildY, apTopY
    for ci, cat in ipairs(hub.cats) do
        if ci > 1 then y = y + 8 end
        Txt(hub, kk("cat", ci), cat.upper or cat.name, 18, y + 8, C.dim, 1, 16, 10, true)
        y = y + 22
        for _, p in ipairs(cat.pages) do
            if #p.children == 0 then
                sideRow(hub, p, y, 30, 1, false)
                if hub.active == p then ty, th = y, 30 end
                if p == ap then apTopY = y + 15 end
                y = y + 32
            else
                local inside = hub.active and hub.active.parent == p
                local e = ani(p, "exp", inside and 1 or 0, 12)
                sideRow(hub, p, y, 30, 1, false)
                if ap and ap.parent == p then apParentY, apParentE = y + 15, e end
                y = y + 32
                for _, c in ipairs(p.children) do
                    if e > 0.03 then sideRow(hub, c, y, 26, e, true) end
                    if hub.active == c then ty, th = y, 26 end
                    if c == ap and e > 0.03 then apChildY = y + 13 end
                    y = y + 28 * e
                end
            end
        end
    end
    -- orange "!" badge: sits on the Settings icon; as Settings opens it slides down onto the Configs row
    local aa = ani(hub, "alertA", (ap and hub.dirty) and 1 or 0, 12)
    if aa > 0.02 and (apParentY or apTopY) and not hub.noBadge then
        local bx, by
        if apParentY then
            local t = apChildY and apParentE or 0
            bx = lerp(35, 43, t)
            by = lerp(apParentY - 7, (apChildY or apParentY) - 6, t)
        else
            bx, by = 35, apTopY - 7
        end
        local r = 6 * aa
        Circ(hub, "alb", bx, by, r + 1.8, C.side, aa, 19, true)          -- ring in the sidebar colour, separates it from the icon
        Circ(hub, "alc", bx, by, r, WARN, aa, 20, true)
        Txt(hub, "alt", "!", bx, by, WARN_INK, aa, 21, 10, true, "c")    -- a real "!" character, centred in the badge
    end
    if ty then
        -- the highlight is animated in list coordinates (so it does not lag while the list scrolls), then shifted
        local hy = ani(hub, "hy", ty + sa, 16) - sa
        local hh = ani(hub, "hh", th, 16)
        Box2(hub, "hl", 8, hy, SW - 16, hh, mix(C.side, C.text, 0.07), mix(C.side, C.text, 0.15), 1, 14, 7)
        Rect(hub, "hlbar", 8, hy + hh / 2 - 7, 2.5, 14, C.accent, 1, 15, true, 1)
    end
    CLIP0, CLIP1 = nil, nil

    -- scroll range: whatever does not fit between the top and the footer line
    local maxS = max(0, (y + sa) + 6 - SIDE_BOT)
    hub.sideMax = maxS
    -- picking a page scrolls it into view
    if hub.sideReveal and ty then
        hub.sideReveal = nil
        local rt, rb = ty + sa, ty + sa + th
        local t = hub.sideT or 0
        if rt - t < SIDE_TOP + 6 then t = rt - SIDE_TOP - 6 elseif rb - t > SIDE_BOT - 6 then t = rb - SIDE_BOT + 6 end
        hub.sideT = t
    end
    hub.sideT = clamp(hub.sideT or 0, 0, maxS)

    if maxS > 1 then
        -- soft fades at the cut edges (same trick as the page content)
        local fb = clamp((maxS - sa) / 24, 0, 1)
        local ft = clamp(sa / 24, 0, 1)
        for i = 0, 5 do
            local a = (1 - i / 6) ^ 2 * 0.95
            if fb > 0.01 then Rect(hub, 700 + i, 1, SIDE_BOT - (i + 1) * 4, SW - 1, 4, C.side, a * fb, 18, true, 0) end
            if ft > 0.01 then Rect(hub, 800 + i, 1, SIDE_TOP + i * 4, SW - 1, 4, C.side, a * ft, 18, true, 0) end
        end
        -- thin scrollbar on the sidebar's right edge
        local ty0, trackH = SIDE_TOP + 4, SIDE_BOT - SIDE_TOP - 8
        local viewH = SIDE_BOT - SIDE_TOP
        local thumbH = max(16, trackH * viewH / (viewH + maxS) * 0.85)
        local thumbY = ty0 + (trackH - thumbH) * clamp(sa / maxS, 0, 1)
        local hv = hot(SW - 12, ty0, 10, trackH)
        if hv and M.pressed and not dragOwner then dragOwner = hub.sideBar end
        if dragOwner == hub.sideBar then
            if M.down then hub.sideT = clamp((M.y - ty0 - thumbH / 2) / (trackH - thumbH), 0, 1) * maxS else dragOwner = nil end
        end
        local sb_a = ani(hub, "sideBarA", (hv or dragOwner == hub.sideBar) and 1 or 0, 14)
        Rect(hub, "sbt2", SW - 7 - sb_a, thumbY, 2 + sb_a, thumbH, mix(C.accent, C.bg, 0.55), 0.55 + 0.4 * sb_a, 19, true, 1)
    end
end

-- Tooltip: appears after the mouse rests on a row that has a `tip` for 0.5s, stays put, fades in and out.
local function drawTip(hub)
    if TIPC ~= hub.tipRow then
        hub.tipRow, hub.tipT = TIPC, 0
        if TIPC then
            local lines, mw = wrap(TIPC.tip, 190, 11.5), 0
            for _, l in ipairs(lines) do mw = max(mw, tw(l, 11.5)) end
            hub.tipLines, hub.tipW = lines, mw + 22
        end
    elseif TIPC then
        hub.tipT = hub.tipT + DT
    end
    if TIPC and hub.tipT < 0.5 then hub.tipX, hub.tipY = M.x, M.y end        -- follows the mouse until it appears
    local ta = ani(hub, "tipA", (TIPC and hub.tipT >= 0.5) and 1 or 0, 16)
    if ta < 0.02 or not hub.tipLines then return end
    local lines, w_ = hub.tipLines, hub.tipW
    local h_ = #lines * 15 + 14
    local x = clamp((hub.tipX or 0) + 12, SW + 6, W - w_ - 8)
    local y = (hub.tipY or 0) + 20
    if y + h_ > H - 6 then y = (hub.tipY or 0) - h_ - 8 end
    Box2(hub, "tipbg", x, y, w_, h_, C.popup, mix(C.border, C.accent, 0.3), ta, 60, 7)
    for i, l in ipairs(lines) do
        Txt(hub, kk("tip", i), l, x + 11, y + 7 + (i - 0.5) * 15, mix(C.dim, C.text, 0.8), ta, 62, 11.5, false)
    end
end

local function drawContent(hub)
    local x0, cw = SW + 16, W - SW - 32
    local colw = (cw - 14) / 2
    local y0, y1 = HDR + 10, H - 12
    hub.clock = hub.clock + DT
    local boxes
    local searching = hub.query ~= ""
    if searching then boxes = searchBoxes(hub) else boxes = hub.active and hub.active.boxes or {} end
    hub.scroll = ani(hub, "scroll", hub.scrollT, 16)
    local cy = { Left = 0, Right = 0 }
    CLIP0, CLIP1 = y0, y1
    for idx, box in ipairs(boxes) do
        local side = box.side
        if side == "auto" then side = (cy.Left <= cy.Right) and "Left" or "Right" end
        local bx = x0 + ((side == "Right") and (colw + 14) or 0)
        local e = clamp((hub.clock - (idx - 1) * 0.06) / 0.4, 0, 1)
        e = PERF and 1 or (1 - (1 - e) ^ 3)    -- Performance Mode: boxes appear at once
        local save = GA
        GA = GA * e
        -- e is also passed down so the box frame fades in first and its contents follow
        local h = drawBox(box, bx, y0 - hub.scroll + cy[side] + (1 - e) * 12, colw, 20, e)
        GA = save
        cy[side] = cy[side] + h
    end
    if searching and #boxes == 0 then
        Txt(hub, "nores", "No results", x0 + cw / 2, y0 + 60, C.dim, 1, 20, 13, true, "c")
    end
    CLIP0, CLIP1 = nil, nil
    local total = max(cy.Left, cy.Right)
    local viewH = y1 - y0
    hub.maxScroll = max(0, total - viewH)
    hub.scrollT = clamp(hub.scrollT, 0, hub.maxScroll)
    local fb = clamp((hub.maxScroll - hub.scroll) / 24, 0, 1)
    local ft = clamp(hub.scroll / 24, 0, 1)
    for i = 0, 7 do
        local a = (1 - i / 8) ^ 2 * 0.95
        if fb > 0.01 then Rect(hub, 500 + i, SW + 1, y1 - (i + 1) * 3, W - SW - 2, 3, C.bg, a * fb, 38, true, 0) end
        if ft > 0.01 then Rect(hub, 600 + i, SW + 1, y0 + i * 3, W - SW - 2, 3, C.bg, a * ft, 38, true, 0) end
    end
    if hub.maxScroll > 1 then
        -- scrollbar with breathing room: 9px from the window edge, and a few px short of the header / bottom edge
        local ty0, trackH = y0 + 4, viewH - 10
        local thumbH = max(18, trackH * viewH / (viewH + hub.maxScroll) * 0.85)
        local f = hub.maxScroll > 0 and (hub.scroll / hub.maxScroll) or 0
        local ty = ty0 + (trackH - thumbH) * clamp(f, 0, 1)
        local hv = hot(W - 20, ty0, 16, trackH)
        if hv and M.pressed and not dragOwner then dragOwner = hub end
        if dragOwner == hub then
            if M.down then
                hub.scrollT = clamp((M.y - ty0 - thumbH / 2) / (trackH - thumbH), 0, 1) * hub.maxScroll
            else dragOwner = nil end
        end
        local sa = ani(hub, "sba", (hv or dragOwner == hub) and 1 or 0, 14)
        Rect(hub, "sbt", W - 11, ty0, 2, trackH, C.track, 0.2, 40, true, 1)
        Rect(hub, "sbh", W - 11 - sa, ty, 2 + sa, thumbH, mix(C.accent, C.bg, 0.55), 0.55 + 0.4 * sa, 41, true, 1)
    end
end

-- One header pill: [dot] text. Its right edge sits at `right`; returns its left edge (nil if it would run into the
-- search box, in which case nothing is drawn). Used by the build tags, the FPS / ping readouts and the config chip.
local function headerPill(o, right, text, col, limit, dotCol, textCol)
    local S = TAG_STYLE
    local txw = tw(text, S.size) * S.widthScale + (S.faux and 1 or 0)
    local w_ = S.padX * 2 + 4.4 + S.dotGap + txw
    local left = right - w_
    if left < limit then return nil end
    local hcy = HDR / 2
    local ty = hcy - S.height / 2
    local hv = hot(left, ty, w_, S.height)
    local ha = ani(o, "h", hv and 1 or 0, 14)
    Box2(o, "bx", left, ty, w_, S.height, mix(C.group, col, 0.14 + 0.08 * ha), mix(C.border, col, 0.55 + 0.25 * ha), 1, 21, 6)
    Circ(o, "dot", left + S.padX + 2.2, hcy, 2.2, dotCol or col, 1, 23, true)
    local tx0 = left + S.padX + 4.4 + S.dotGap + S.textDX
    Txt(o, "tx", text, tx0, hcy + 0.5 + S.textDY, textCol or col, 1, 23, S.size, S.font)
    if S.faux then Txt(o, "tx2", text, tx0 + 1, hcy + 0.5 + S.textDY, textCol or col, 1, 23, S.size, S.font) end
    return left, hv
end

local function drawHeader(hub)
    local sb = hub.searchBox
    local hcy = HDR / 2                      -- vertical centre of the header
    local hv = hot(SW + 10, hcy - 14, 240, 28)
    -- clear button (only while there is text): wipes the search and keeps the box focused
    local hasText = sb.text ~= ""
    local xh = hasText and hot(SW + 222, hcy - 10, 20, 20)
    if xh and M.pressed then
        sb.text = ""; hub.query = ""; hub.scrollT = 0
        focusText(sb)
    elseif hv and M.pressed then focusText(sb) end
    if hv then sb.hovFrame = frameId end
    local foc = TI.owner == sb
    local fa = ani(sb, "f", foc and 1 or 0, 14)
    local ha = ani(sb, "h", hv and 1 or 0, 14)
    Icon(sb, "ic", "search", SW + 26, hcy, 16, mix(mix(C.dim, C.text, ha * 0.6), C.accent, fa), 1, 21)
    if sb.text == "" and not foc then
        Txt(sb, "ph", "Search...", SW + 42, hcy, mix(C.dim, C.text, ha * 0.5), 1, 21, 13, false)
    else
        Txt(sb, "tx", sb.text, SW + 42, hcy, C.text, 1, 21, 13, false)
    end
    if hasText then
        local xa = ani(sb, "xa", xh and 1 or 0, 14)
        local xc = mix(C.dim, C.text, xa)
        Circ(sb, "xbg", SW + 232, hcy, 7.5, mix(C.group, C.text, 0.06 + 0.08 * xa), 1, 21, true)
        Ln(sb, "x1", SW + 229.5, hcy - 2.5, SW + 234.5, hcy + 2.5, xc, 1, 22, 1.3)
        Ln(sb, "x2", SW + 229.5, hcy + 2.5, SW + 234.5, hcy - 2.5, xc, 1, 22, 1.3)
    end
    if foc and floor(tick() * 2) % 2 == 0 then
        Rect(sb, "car", SW + 43 + tw(sb.text, 13), hcy - 8, 1, 16, C.text, 1, 22, true, 0)
    end
    Rect(sb, "ul", SW + 20, hcy + 11, 220 * fa, 1.5, C.accent, 1, 22, true, 1)

    -- top right, right to left: build tags, config chip, ping, FPS (whatever does not fit is skipped)
    local right, limit = W - 18, SW + 262
    hub.chipHot = false
    for i = #hub.tags, 1, -1 do
        local t = hub.tags[i]
        local left = headerPill(t, right, t.text, t.col, limit)
        if not left then break end
        right = left - 6
    end
    if hub:Get("hdr_stats") ~= false then
        -- config chip: dot is dim with no config, accent when loaded, orange while there are unsaved changes
        local da = ani(hub, "chipD", hub.dirty and 1 or 0, 12)
        local name = hub.cfgName and fit(hub.cfgName, 90, TAG_STYLE.size) or "No config"
        local dot = mix(mix(C.dim, C.accent, hub.cfgName and 0.8 or 0), WARN, da)
        local left, chv = headerPill(hub.chip, right, name, mix(C.dim, WARN, da * 0.9), limit, dot, mix(C.dim, C.text, 0.35 + 0.4 * da))
        if left then
            right = left - 6
            if chv then hub.chipHot = true; if M.pressed then hub:Select(hub.alertPage) end end
        end
        -- ping + FPS refresh a couple of times per second (the width follows the text)
        hub.statT = (hub.statT or 0) - DT
        if hub.statT <= 0 then
            hub.statT = 0.5
            hub.fpsTxt = string.format("%d FPS", floor(hub.fps + 0.5))
        end
        local pms = hub.pingMs
        if pms then
            local pc = pms < 60 and C.accent or (pms < 120 and WARN or RED)
            left = headerPill(hub.pingPill, right, hub.pingPillTxt, C.dim, limit, pc, mix(C.dim, C.text, 0.35))
            if left then right = left - 6 end
        end
        if hub.fpsTxt then
            local fc = hub.fps >= 50 and C.accent or (hub.fps >= 30 and WARN or RED)
            headerPill(hub.fpsPill, right, hub.fpsTxt, C.dim, limit, fc, mix(C.dim, C.text, 0.35))
        end
    end
end

-- Header logo: downloaded from the repo by Lime:LoadIcons() (see LOGO_FILES / LogoUrl) --------
local VERSION = "1.0.0"
local LOGO_W, LOGO_H = 64, 34          -- the logo is fitted inside this box, keeping its own aspect ratio
local AVATAR_DATA                      -- raw PNG bytes of the local player's headshot, set once downloaded
local LOGO_FILES = { "fzzr.png", "Fzzr.png", "FZZR.png", "logo.png", "Logo.png", "fzzr_logo.png", "fzzr-logo.png", "FzzrLogo.png" }   -- tried in order under IMG_BASE
local LOGO_DATA                        -- raw PNG bytes, set once downloaded
local LOGO_DW, LOGO_DH = LOGO_W, LOGO_H
local function setLogo(data)
    LOGO_DATA = data
    -- PNG header: width/height are big-endian u32 at bytes 17-24
    local b = { data:byte(17, 24) }
    if #b == 8 then
        local w = ((b[1] * 256 + b[2]) * 256 + b[3]) * 256 + b[4]
        local h = ((b[5] * 256 + b[6]) * 256 + b[7]) * 256 + b[8]
        if w > 0 and h > 0 then
            local sc = min(LOGO_W / w, LOGO_H / h)
            LOGO_DW, LOGO_DH = floor(w * sc + 0.5), floor(h * sc + 0.5)
        end
    end
end

local function drawFooter(hub)
    hub.pingT = (hub.pingT or 0) - DT
    if hub.pingT <= 0 then
        hub.pingT = 1
        local ok, p = pcall(GetPingValue)
        hub.pingTxt = ok and (floor(p) .. " ms") or ""
        hub.pingMs = ok and floor(p) or nil            -- parsed once a second, not pattern-matched every frame
        hub.pingPillTxt = hub.pingMs and (hub.pingMs .. " ms") or nil
    end
    local hidden = (hub:Get("user_disp") == "Hidden")
    local name = hidden and "user" or LocalPlayer.Name
    local fy = H - 54
    Ln(hub, "ftl", 14, fy, SW - 14, fy, C.border, 1, 16, 1)
    if AVATAR_DATA and not hidden then
        -- real avatar headshot, clipped to a circle through the Image's Rounding
        Circ(hub, "fta", 30, fy + 27, 12, mix(C.side, C.accent, 0.3), 1, 15, true)
        local d = get(hub, "avatar", "Image")
        local c, obj = d.c, d.obj
        if not c.dset then c.dset = true; obj.Data = AVATAR_DATA end
        if not c.sset then c.sset = true; obj.Size = Vector2.new(24, 24) end
        local X, Y = px(18), py(fy + 15)
        if c.px ~= X or c.py ~= Y then c.px = X; c.py = Y; obj.Position = Vector2.new(X, Y); WR = WR + 1 end
        set(d, "Rounding", 12)
        set(d, "Transparency", floor(GA * 100 + 0.5) / 100)
        set(d, "ZIndex", 16)
        show(d)
        Circ(hub, "ftr", 30, fy + 27, 12.5, mix(C.side, C.accent, 0.7), 1, 17, false, 1.2)
    else
        Circ(hub, "fta", 30, fy + 27, 12, mix(C.side, C.accent, 0.3), 1, 16, true)
        Circ(hub, "ftr", 30, fy + 27, 12, mix(C.side, C.accent, 0.7), 1, 17, false, 1.2)
        Txt(hub, "fti", string.upper(name:sub(1, 1)), 30, fy + 27, C.text, 1, 18, 12, true, "c")
    end
    Txt(hub, "ftn", fit(name, SW - 62, 12), 50, fy + 21, C.text, 1, 17, 12, true)
    Txt(hub, "ftp", hub.pingTxt or "", 50, fy + 35, mix(C.dim, C.bg, 0.25), 1, 17, 10.5, false)
end

local function drawWindow(hub)
    -- soft drop shadow: 9 stacked layers whose alpha fades toward the outside, so the stacked
    -- result is a smooth falloff instead of 5 hard bands. Shifted slightly down for depth.
    -- Static rects: after the first frame only Transparency is touched (during the fade).
    local SHN = 9
    for i = PERF and 0 or SHN, 1, -1 do      -- Performance Mode: start below the end value = no shadow layers
        local g = i * 1.9
        local a = 0.045 * (1 - (i - 1) / SHN)
        Rect(hub, 400 + i, -g, -g + 6, W + g * 2, H + g * 2, C.black, a, 9, true, 10 + g)
    end
    Box2(hub, "win", 0, 0, W, H, C.bg, C.border, 1, 10, 10)
    Rect(hub, "sb", 1, 1, SW, H - 2, C.side, 1, 12, true, 9)
    Rect(hub, "sb2", SW - 9, 1, 10, H - 2, C.side, 1, 12, true, 0)
    Ln(hub, "sbl", SW, 1, SW, H - 1, C.border, 1, 13, 1)
    Ln(hub, "hl", SW, HDR, W - 1, HDR, C.border, 1, 13, 1)
    -- logo (top left) + darkened version tag; falls back to the plain title if the PNG fails to decode
    if LOGO_DATA then
        local LTOP = 7                                   -- logo top; the version tag sits right under it
        local gcx, gcy = 14 + LOGO_DW / 2, LTOP + LOGO_DH / 2
        local gcol = mix(C.side, C.accent, 0.5)
        for i = PERF and 0 or 5, 1, -1 do    -- Performance Mode: no logo glow
            local g = i * 2.2
            Rect(hub, 300 + i, gcx - LOGO_DW / 2 - g, gcy - LOGO_DH / 2 - g * 0.45, LOGO_DW + g * 2, LOGO_DH + g * 0.9,
                gcol, 0.018, 16, true, 8 + g * 1.5)
        end
        local d = get(hub, "logo", "Image")
        local c, obj = d.c, d.obj
        if not c.dset then c.dset = true; obj.Data = LOGO_DATA end
        local sx, sy = LOGO_DW, LOGO_DH
        if c.sx ~= sx or c.sy ~= sy then c.sx = sx; c.sy = sy; obj.Size = Vector2.new(sx, sy) end
        local X, Y = px(14), py(LTOP)
        if c.px ~= X or c.py ~= Y then c.px = X; c.py = Y; obj.Position = Vector2.new(X, Y); WR = WR + 1 end
        set(d, "Transparency", floor(GA * 100 + 0.5) / 100)
        set(d, "ZIndex", 17)
        show(d)
        Txt(hub, "ver", "v" .. hub.version, 16, LTOP + LOGO_DH + 8, mix(C.dim, C.bg, 0.4), 1, 17, 10, true)
    else
        Txt(hub, "title", hub.title, 20, 28, C.text, 1, 16, 24, true)
        Txt(hub, "ver", "v" .. hub.version, 20 + tw(hub.title, 24) + 6, 34, mix(C.dim, C.bg, 0.4), 1, 16, 10, true)
    end
end

local function drawOne(p, zb)
    CLIP0, CLIP1 = nil, nil
    local t = ani(p, "__t", p.closing and 0 or 1, 20)
    if p.closing and t < 0.02 then return false end
    local ph = ani(p, "__h", p.measure(p), 18)
    local pxx, pyy = p.x, p.y
    local vw, vh = VW, VH
    local fw = p.w + (p.exw or 0)
    if OX + pxx + fw > vw - 8 then pxx = vw - 8 - OX - fw end
    if OX + pxx < 8 then pxx = 8 - OX end
    if OY + pyy + ph > vh - 8 then pyy = vh - 8 - OY - ph end
    p.rx, p.ry, p.rw, p.rh = pxx, pyy, fw, ph
    local save = GA
    GA = save * t
    local yoff = (1 - t) * -6
    Rect(p, "sh", pxx - 1, pyy + yoff + 3, p.w + 2, ph + 2, C.black, 0.35, zb, true, 9)
    Box2(p, "bg", pxx, pyy + yoff, p.w, ph, C.popup, C.border, 1, zb + 1, 8)
    CLIP0, CLIP1 = pyy + yoff + 2, pyy + yoff + ph - 2
    ctxOK = not p.closing
    p.content(p, pxx, pyy + yoff, zb + 4)
    CLIP0, CLIP1 = nil, nil
    GA = save
    return true
end

local function drawPopup(hub)
    local p = POP
    if not p then return end
    if p.closing and p.child then p.child.closing = true end
    if not drawOne(p, 200) then POP = nil; return end
    local c = p.child
    if c and not drawOne(c, 230) then p.child = nil; c = nil end
    if M.pressed and p.born ~= frameId and not p.closing then
        local function inside(q) return q and M.x >= q.rx and M.x <= q.rx + q.rw and M.y >= q.ry and M.y <= q.ry + q.rh end
        local inP, inC = inside(p), inside(c)
        if c and not c.closing and c.born ~= frameId and not inC then
            c.closing = true
            if not inP then p.closing = true end
        elseif not c and not inP then
            p.closing = true
        end
    end
end

