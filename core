local function bindActive(it, b)
    if b.mode == "Toggle" then return it.value end
    if b.mode == "Hold" then return kd[b.vk] and true or false end
    return false
end

local function drawWatermark(hub)
    local a = ani(hub, "wma", hub:Get("wm") and 1 or 0, 10)
    if a < 0.01 then return end
    hub.wmT = (hub.wmT or 0) - DT
    if hub.wmT <= 0 then
        hub.wmT = 0.5
        local name = (hub:Get("user_disp") == "Hidden") and "user" or LocalPlayer.Name
        local ok, ping = pcall(GetPingValue)
        hub.wmText = string.format("%s  |  %s  |  %d ms  |  %d fps", hub.title, name, ok and floor(ping) or 0, floor(hub.fps))
    end
    local text = hub.wmText or hub.title
    local w = tw(text, 12) + 26
    local vw = VW
    GA = a
    local x = vw - w - 16 + (1 - a) * 16
    Box2(hub, "wm", x, 14, w, 26, C.group, C.border, 1, 150, 7)
    Rect(hub, "wmL", x + 8, 15, w - 16, 2, C.accent, 1, 152, true, 1)
    Txt(hub, "wmT", text, x + 13, 28, C.text, 1, 153, 12, true)
    GA = 1
end

local function drawBindList(hub)
    local a = ani(hub, "bla", hub:Get("bl") and 1 or 0, 10)
    if a < 0.01 then return end
    local activeOnly = hub:Get("bl_active")
    local rows, n = hub.blRows, 0
    if not rows then rows = {}; hub.blRows = rows end
    for _, it in ipairs(hub.bindList) do
        for _, b in ipairs(it.binds) do
            if b.show and b.vk ~= 0 then
                local act = bindActive(it, b)
                if act or not activeOnly then
                    n = n + 1
                    local r = rows[n]
                    if not r then r = {}; rows[n] = r end
                    r[1], r[2], r[3] = it.label, b.vk, act
                end
            end
        end
    end
    for i = #rows, n + 1, -1 do rows[i] = nil end
    local bl = hub.bl
    -- drag by header (raw mouse, only while the menu is open)
    if hub.open then
        local over = M.rawx >= bl.x and M.rawx <= bl.x + 156 and M.rawy >= bl.y and M.rawy <= bl.y + 30
        if M.pressed and over and not dragOwner then bl.drag = { M.rawx - bl.x, M.rawy - bl.y } end
    end
    if bl.drag then
        if M.down then bl.x = M.rawx - bl.drag[1]; bl.y = M.rawy - bl.drag[2] else bl.drag = nil end
    end
    local target = 30 + #rows * 22 + ((#rows > 0) and 8 or 2)
    local bh = ani(hub, "blh", target, 12)
    GA = a
    Box2(hub, "bl", bl.x, bl.y, 156, bh, C.group, C.border, 1, 150, 8)
    Icon(hub, "blic", "grid", bl.x + 18, bl.y + 15, 14, C.accent, 1, 153)
    Txt(hub, "blt", "Binds", bl.x + 32, bl.y + 15, C.text, 1, 153, 13, true)
    CLIP0, CLIP1 = bl.y + 30, bl.y + bh - 3
    for i, r in ipairs(rows) do
        local ry = bl.y + 30 + (i - 1) * 22
        local ra = ani(hub, kk("blr", i), r[3] and 1 or 0, 12)
        Txt(hub, kk("bll", i), r[1], bl.x + 14, ry + 11, mix(C.dim, C.text, ra), 1, 153, 12, true)
        local kn = r[4]                                   -- "[Key]" text cached per row (rebuilt only when the key changes)
        if r[5] ~= r[2] then r[5] = r[2]; kn = "[" .. keyName(r[2]) .. "]"; r[4] = kn end
        Txt(hub, kk("blk", i), kn, bl.x + 156 - 12, ry + 11, mix(C.dim, C.accent, ra), 1, 153, 12, true, "r")
    end
    CLIP0, CLIP1 = nil, nil
    GA = 1
end

local function drawToasts(hub)
    if #hub.toasts == 0 then return end              -- nothing to draw: skip the setting lookup and the table below
    local vw, vh = VW, VH
    local gpos = hub:Get("toast_pos") or "Center Bottom"
    local cursors = {}
    for i = #hub.toasts, 1, -1 do
        local t = hub.toasts[i]
        local pos = t.pos or gpos
        local bottom = pos:find("Bottom") ~= nil
        local cursor = cursors[pos] or 0
        local h = t.total and 56 or 46
        local sub = t.total and (floor(t.cur) .. "/" .. t.total) or t.text
        local w = max(190, tw(t.title, 13) + (t.icon and 70 or 36), tw(sub, 12) + (t.icon and 70 or 36))
        if t.dur and tick() - t.born > t.dur then t.closing = true end
        local life = ani(t, "in", t.closing and 0 or 1, 12)
        if t.closing and life < 0.02 then
            release(t); table.remove(hub.toasts, i)
        else
            local slot = ani(t, "slot", cursor, 12)
            cursors[pos] = cursor + (h + 8) * life
            local x
            if pos:find("Left") then x = 16 elseif pos:find("Right") then x = vw - w - 16 else x = (vw - w) / 2 end
            local y
            if bottom then y = vh - 28 - h - slot + (1 - life) * 18 else y = 28 + slot - (1 - life) * 18 end
            GA = life
            Box2(t, "bg", x, y, w, h, C.popup, C.border, 1, 300, 9)
            local tx = x + 16
            if t.icon then
                Icon(t, "ic", t.icon, x + 26, y + h / 2 - (t.total and 4 or 0), 18, C.text, 1, 303)
                tx = x + 48
            end
            Txt(t, "ti", t.title, tx, y + 17, C.text, 1, 303, 13, true)
            Txt(t, "tx", sub, tx, y + 33, C.dim, 1, 303, 12, false)
            if t.total then
                local bw = w - 32
                local f = ani(t, "f", clamp(t.cur / t.total, 0, 1), 14)
                Rect(t, "tr", x + 16, y + h - 12, bw, 3, C.track, 1, 303, true, 1.5)
                Rect(t, "fl", x + 16, y + h - 12, max(2, bw * f), 3, C.text, 1, 304, true, 1.5)
            end
            GA = 1
        end
    end
end

--========================================================================
-- Frame step
--========================================================================
local function pollInput()
    M.rawx, M.rawy = Mouse.X, Mouse.Y
    local down = ismouse1pressed() and isrbxactive()
    M.pressed = down and not M.down
    M.down = down
    M.x, M.y = M.rawx - OX, M.rawy - OY
end

local function step(hub)
    local now = tick()
    local wr0 = WR
    DT = clamp(now - hub.last, 0.001, 0.05)
    hub.last = now
    frameId = frameId + 1
    TIPC = nil                                   -- rows set this again while hovered
    -- viewport: one property read per frame (and a camera re-fetch every ~2 s in case the game swapped it)
    if frameId % 120 == 0 then Camera = workspace.CurrentCamera or Camera end
    local vsz = Camera.ViewportSize
    VW, VH = vsz.X, vsz.Y
    if hub.autoCenter and not hub.centered then
        hub.pos[1], hub.pos[2] = floor((VW - W) / 2), floor((VH - H) / 2)
        if hub.ready then hub.centered = true end        -- from now on the player owns the position (drag)
    end
    PERF = hub:Get("perf_mode") == true
    hub.fps = lerp(hub.fps, 1 / DT, 0.05)
    stepTheme()
    CP.animate(hub)

    -- settings that drive the menu itself
    local fade = ani(hub, "fade", hub.open and 1 or 0, 12)
    OX = hub.pos[1]
    OY = hub.pos[2] + (1 - fade) * 14
    GA = 1; CLIP0, CLIP1 = nil, nil
    pollInput()

    local active = isrbxactive()
    local busy = false

    -- key capture (bind rebinding)
    if CAP and active then
        busy = true
        for vk = 2, 254 do
            local _, p = key(vk)
            if p then
                local c = CAP; CAP = nil
                if vk ~= 0x1B then c.set(vk) end
                break
            end
        end
    end
    -- text input
    if TI.owner and active then
        busy = true
        local o = TI.owner
        local changed = false
        local shift = key(0x10)
        for _, vk in ipairs(TYPEVK) do
            local _, p = key(vk)
            if p and #o.text < 24 then
                local ch = vkChar(vk, shift)
                if ch then o.text = o.text .. ch; changed = true end
            end
        end
        local bd, bp = key(8)
        if bp then o.text = o.text:sub(1, #o.text - 1); TI.bs = 0; changed = true
        elseif bd then
            TI.bs = TI.bs + DT
            if TI.bs > 0.45 then o.text = o.text:sub(1, #o.text - 1); TI.bs = 0.4; changed = true end
        end
        local _, ent = key(13)
        local _, esc = key(27)
        if ent or esc then TI.owner = nil end
        if changed and o.onText then o.onText(o.text) end
    end

    -- menu toggle
    if active and not busy then
        local _, p = key(hub:Get("menu_key") or 0x46)
        if p and hub.ready then
            hub.open = not hub.open
            if not hub.open then closePop(); TI.owner = nil end
        end
    end

    -- bind processing (works with the menu closed)
    if active and not busy then
        for _, it in ipairs(hub.bindList) do
            for _, b in ipairs(it.binds) do
                if b.vk ~= 0 and b.mode ~= "Off" then
                    local d, p = key(b.vk)
                    if b.mode == "Toggle" then
                        if p then it:Set(not it.value) end
                    elseif d ~= b.last then
                        b.last = d
                        it:Set(d)
                    end
                end
            end
        end
    end

    -- mouse wheel scroll (best effort) is applied in the input hook below
    ctxOK = hub.open and fade > 0.85 and not (POP and not POP.closing)

    -- scrolling without the mouse wheel (Matcha has no wheel event): Up / Down arrows, PgUp / PgDn, Home / End
    -- while the pointer is over the page, or hold the middle mouse button and drag
    if ctxOK and active and not busy and M.x > SW and M.x < W and M.y > HDR and M.y < H then
        local dn, up = key(0x28), key(0x26)
        if dn then hub.scrollT = hub.scrollT + 520 * DT end
        if up then hub.scrollT = hub.scrollT - 520 * DT end
        local _, pd = key(0x22)
        local _, pu = key(0x21)
        if pd then hub.scrollT = hub.scrollT + (H - HDR) * 0.8 end
        if pu then hub.scrollT = hub.scrollT - (H - HDR) * 0.8 end
        local _, hm = key(0x24)
        local _, en = key(0x23)
        if hm then hub.scrollT = 0 end
        if en then hub.scrollT = hub.maxScroll end
        local md, mp = key(0x04)
        if mp then hub.grabY = M.rawy end
        if md and hub.grabY then hub.scrollT = hub.scrollT - (M.rawy - hub.grabY); hub.grabY = M.rawy end
        hub.scrollT = clamp(hub.scrollT, 0, hub.maxScroll)
    elseif ctxOK and active and not busy and M.x >= 0 and M.x <= SW and M.y > HDR and M.y < H and hub.sideMax > 0 then
        -- same controls over the sidebar: they scroll the page list instead
        local dn, up = key(0x28), key(0x26)
        if dn then hub.sideT = hub.sideT + 360 * DT end
        if up then hub.sideT = hub.sideT - 360 * DT end
        local _, hm = key(0x24)
        local _, en = key(0x23)
        if hm then hub.sideT = 0 end
        if en then hub.sideT = hub.sideMax end
        local md, mp = key(0x04)
        if mp then hub.grabY = M.rawy end
        if md and hub.grabY then hub.sideT = hub.sideT - (M.rawy - hub.grabY); hub.grabY = M.rawy end
        hub.sideT = clamp(hub.sideT, 0, hub.sideMax)
    end

    -- window dragging
    if hub.drag then
        if M.down then
            hub.pos[1] = M.rawx - hub.drag[1]
            hub.pos[2] = M.rawy - hub.drag[2] + 0
        else hub.drag = nil end
    elseif ctxOK and M.pressed and not dragOwner and M.y >= 0 and M.y < HDR and M.x >= 0 and M.x <= W - 12
        and not (M.x > SW + 10 and M.x < SW + 250) and not hub.chipHot then
        hub.drag = { M.rawx - hub.pos[1], M.rawy - hub.pos[2] }
    end

    -- screen-space HUD
    local mOX, mOY = OX, OY
    OX, OY = 0, 0
    local vw, vh = VW, VH
    if hub:Get("blur") and not PERF then
        local bd = ani(hub, "bd", hub.open and (hub:Get("blurpx") or 40) / 100 * 0.55 or 0, 8)
        Rect(hub, "bd", 0, 0, vw, vh, C.black, bd, 0, true, 0)
    end
    drawWatermark(hub)
    drawBindList(hub)
    drawToasts(hub)
    OX, OY = mOX, mOY

    -- menu
    local trans = (hub:Get("trans") or 0) / 100
    GA = fade * (1 - trans)
    if fade > 0.01 then
        drawWindow(hub)
        drawSidebar(hub)
        drawFooter(hub)
        drawHeader(hub)
        drawContent(hub)
        drawTip(hub)
    end
    drawPopup(hub)
    GA = 1; CLIP0, CLIP1 = nil, nil

    -- end-of-frame input housekeeping
    if dragOwner and not M.down then dragOwner = nil end
    if M.pressed and TI.owner and TI.owner.hovFrame ~= frameId then TI.owner = nil end

    -- startup toast
    if not hub.ready and now - hub.born > 25 then hub.ready = true; hub.open = hub.wantOpen end  -- never stay hidden if a download hangs
    if hub.ready and not hub.startToast then
        hub.startToast = true
        -- only announce a config when one was really autoloaded
        if hub.cfgName then hub:Toast({ Title = "Config loaded", Text = hub.cfgName, Icon = "download", Duration = 3.5 }) end
    end
    hub:CfgTick(now)      -- unsaved-change check (every 0.4s) + auto save
    sweep()
    hub.wrAvg = hub.wrAvg + ((WR - wr0) - hub.wrAvg) * 0.05
    if hub.debugPage and hub.active == hub.debugPage and fade > 0.5 then hub:DebugTick(now) end
end

--========================================================================
-- Constructor
--========================================================================
function Lime.Create(opts)
    opts = opts or {}
    local hub = setmetatable({}, Lime)
    hub.title = opts.Title or "fzzr"
    hub.version = opts.Version or VERSION
    hub.logoUrl = opts.LogoUrl
    if opts.IconBase then IMG_BASE = opts.IconBase end          -- folder that holds the icon PNGs
    hub.sideBar, hub.sideT, hub.sideMax = {}, 0, 0                    -- sidebar list scroll
    -- the window is centred by default; Position is only used when Center = false is passed as well
    if opts.Position and opts.Center == false then
        hub.pos = opts.Position
    else
        -- no position given: centre the window on screen (re-centred until the menu first opens, see step())
        local vs = Camera.ViewportSize
        hub.pos = { floor((vs.X - W) / 2), floor((vs.Y - H) / 2) }
        hub.autoCenter = true
    end
    hub.pages, hub.cats, hub.items, hub.bindList, hub.toasts = {}, {}, {}, {}, {}
    hub.colorItems = {}
    hub.tags = {}
    hub.chip, hub.pingPill, hub.fpsPill = {}, {}, {}   -- draw owners for the header pills
    hub.open = true
    hub.query = ""
    hub.clock, hub.scroll, hub.scrollT, hub.maxScroll = 0, 0, 0, 0
    hub.fps = 60
    hub.frameMs, hub.peakMs, hub.peakAt, hub.wrAvg = 0, 0, 0, 0     -- Debug page counters
    hub.dbgExt = {}                                                 -- lines registered with Lime:DebugStat
    hub.last, hub.born = tick(), tick()
    hub.lastFrame = hub.born
    hub.bl = { x = 16, y = 260 }
    hub.searchBox = { text = "", onText = function(t) hub.query = t; hub.scrollT = 0 end }
    hub.PageAPI = PageAPI
    return hub
end

-- Downloads the icon PNGs once, in the background; icons fall back to drawn shapes until they arrive.
local function httpText(url)
    local ok, res = pcall(function()
        if httpget then return httpget(url) end
        return game:HttpGet(url)
    end)
    if ok and type(res) == "string" then return res end
end
local function fetchPng(url)
    local res = httpText(url)
    if res and #res > 8 and res:sub(2, 4) == "PNG" then return res end
end
-- Local player's avatar headshot: asks the thumbnails API for the image url (it can answer "Pending"
-- for a moment, so it retries), then falls back to the direct headshot endpoint.
local function fetchAvatar(userId)
    for _ = 1, 4 do
        local body = httpText("https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=" .. userId ..
            "&size=150x150&format=Png&isCircular=false")
        local url = body and body:match('"imageUrl"%s*:%s*"(.-)"')
        if url then
            local d = fetchPng(url)
            if d then return d end
        end
        wait(0.5)
    end
    return fetchPng("https://www.roblox.com/headshot-thumbnail/image?userId=" .. userId .. "&width=150&height=150&format=png")
end
function Lime:LoadIcons()
    local files, seen = {}, {}
    for _, f in pairs(ICONFILE) do if not seen[f] then seen[f] = true; files[#files + 1] = f end end
    table.sort(files)
    local t = self:Toast({ Title = "Loading " .. self.title, Icon = "download", Total = #files + 2, Current = 0, Pos = "Bottom Left" })
    task.spawn(function()
        wait(0.4)
        local urls = {}
        if self.logoUrl then urls[1] = self.logoUrl
        else for _, nm in ipairs(LOGO_FILES) do urls[#urls + 1] = IMG_BASE .. nm end end
        local logoOK = false
        for _, u in ipairs(urls) do
            local d = fetchPng(u)
            if d then setLogo(d); logoOK = true; break end
        end
        if not logoOK then
            warn("[fzzr] logo not found. Tried: " .. table.concat(urls, "  |  ") ..
                "  -- set CreateWindow({ LogoUrl = \"<direct raw link to the png>\" }) to fix it")
        end
        t:Set(1)
        local okA, av = pcall(fetchAvatar, LocalPlayer.UserId)
        if okA and av then AVATAR_DATA = av end
        t:Set(2)
        for i, f in ipairs(files) do
            if self.dead then return end
            ICONDATA[f] = fetchPng(IMG_BASE .. f .. ".png")
            t:Set(i + 2)
            wait(0.03)
        end
        wait(0.35)
        if self.dead then return end
        self.ready = true
        self.open = self.wantOpen
        wait(0.7)
        t:Close()
    end)
end

function Lime:Run()
    local first = self.items["show_on_load"]
    self.wantOpen = (not first) or first.value
    self.open = false          -- opened by LoadIcons() once all assets are in
    self.ready = false
    _G.__FzzrHub = self
    self.conn = RunService.RenderStepped:Connect(function()
        if self.dead then return end
        local t0 = tick()
        self.lastFrame = t0                      -- heartbeat: a second launch can tell a live menu from a stale one
        local ok, err = pcall(step, self)
        if not ok and not self.warned then self.warned = true; warn("[fzzr] " .. tostring(err)) end
        -- script time per frame (smoothed) and its peak over the last ~5 s, shown on the Debug page
        local ms = (tick() - t0) * 1000
        self.frameMs = self.frameMs + (ms - self.frameMs) * 0.1
        if ms > self.peakMs or t0 - self.peakAt > 5 then self.peakMs = ms; self.peakAt = t0 end
    end)
end

-- best-effort mouse wheel support (ignored silently if the API isn't available)
local function hookWheel(hub)
    pcall(function()
        local UIS = game:GetService("UserInputService")
        UIS.InputChanged:Connect(function(input)
            if hub.dead then return end
            if input.UserInputType == Enum.UserInputType.MouseWheel and hub.open then
                if M.x >= 0 and M.x <= SW and M.y > HDR then        -- pointer over the sidebar: scroll the page list
                    hub.sideT = clamp(hub.sideT - input.Position.Z * 40, 0, hub.sideMax)
                else
                    hub.scrollT = clamp(hub.scrollT - input.Position.Z * 48, 0, hub.maxScroll)
                end
            end
        end)
    end)
end

