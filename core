function Lime:Page(name, opts)
    opts = opts or {}
    local p = setmetatable({ hub = self, name = name, icon = opts.icon, boxes = {}, children = {}, landing = opts.landing }, PageAPI)
    if opts.parent then
        for _, pp in ipairs(self.pages) do
            if pp.name == opts.parent then p.parent = pp; pp.children[#pp.children + 1] = p end
        end
    else
        local cat
        for _, c in ipairs(self.cats) do if c.name == opts.category then cat = c end end
        if not cat then
            local cname = opts.category or "Other"
            cat = { name = cname, upper = string.upper(cname), pages = {} }
            self.cats[#self.cats + 1] = cat
        end
        cat.pages[#cat.pages + 1] = p
    end
    self.pages[#self.pages + 1] = p
    return p
end

function Lime:Select(p)
    if not p then return end
    if #p.children > 0 then
        -- a parent opens its "landing" child if one is marked, otherwise its first child
        local pick = p.children[1]
        for _, c in ipairs(p.children) do if c.landing then pick = c end end
        p = pick
    end
    if self.active ~= p then
        self.active = p
        self.sideReveal = true               -- the sidebar scrolls the picked page into view
        self.clock = 0
        self.scrollT = 0
        if self.__a then self.__a.scroll = 0 end
        closePop()
    end
end

