-- Widget kinds
--========================================================================
local CP = {}
do
    local function hsv2rgb(h, s, v, out)
        local i = floor(h * 6)
        local f = h * 6 - i
        i = i % 6
        local p, q, t = v * (1 - s), v * (1 - f * s), v * (1 - (1 - f) * s)
        local r, g, b
        if i == 0 then r, g, b = v, t, p elseif i == 1 then r, g, b = q, v, p elseif i == 2 then r, g, b = p, v, t
        elseif i == 3 then r, g, b = p, q, v elseif i == 4 then r, g, b = t, p, v else r, g, b = v, p, q end
        out[1], out[2], out[3] = r, g, b
        return out
    end
    local function rgb2hsv(r, g, b)
        local mx, mn = max(r, g, b), min(r, g, b)
        local d = mx - mn
        local h = 0
        if d > 0 then
            if mx == r then h = ((g - b) / d) % 6 elseif mx == g then h = (b - r) / d + 2 else h = (r - g) / d + 4 end
            h = h / 6
        end
        return h, (mx == 0) and 0 or d / mx, mx
    end
    local function ensureHsv(w)
        local hs = w.hsv
        if not hs then hs = { rgb2hsv(w.color[1], w.color[2], w.color[3]) }; w.hsv = hs end
        return hs
    end
    local function b255(v) return floor(clamp(v, 0, 1) * 255 + 0.5) end
    local TMPC = { 0, 0, 0 }

    -- Rainbow / Pulse animation for every colour item (runs even while the menu is closed)
    function CP.animate(hub)
        for _, w in ipairs(hub.colorItems) do
            if w.anim and w.anim > 1 then
                local hs = ensureHsv(w)
                local sp = (w.speed or 100) / 100
                if w.anim == 2 then
                    hs[1] = (hs[1] + DT * 0.25 * sp) % 1
                    hsv2rgb(hs[1], hs[2], hs[3], w.color)
                else
                    hsv2rgb(hs[1], hs[2], hs[3] * (0.65 + 0.35 * sin(tick() * 3 * sp)), w.color)
                end
            end
        end
    end

    local function colorContent(p, x, y, z)
        local w = p.owner
        local hs = ensureHsv(w)
        local col = w.color
        Txt(p, "ti", w.label, x + 12, y + 18, C.text, 1, z, 13.5, true)

        -- gear -> "Advanced" side panel
        local gh = hot(x + p.w - 30, y + 6, 22, 22)
        local ga = ani(p, "gh", gh and 1 or 0, 14)
        if gh and M.pressed then p.adv = not p.adv end
        Icon(p, "gear", "gear", x + p.w - 19, y + 17, 14, mix(C.dim, C.accent, p.adv and 1 or ga), 1, z + 2)
        p.exw = ani(p, "exw", p.adv and 196 or 0, 16)

        -- saturation / value field (cell grid, Drawing has no gradients)
        local ax, ay, aw, ah = x + 12, y + 34, p.w - 24, 110
        local cols, rows = 18, 11
        local cw_, ch_ = aw / cols, ah / rows
        for r = 0, rows - 1 do
            for c = 0, cols - 1 do
                hsv2rgb(hs[1], (c + 0.5) / cols, 1 - (r + 0.5) / rows, TMPC)
                Rect(p, r * 32 + c, ax + c * cw_, ay + r * ch_, cw_ + 0.7, ch_ + 0.7, TMPC, 1, z, true, 0)
            end
        end
        local hy = ay + ah + 10
        local ay2 = hy + 22

        -- grab handling
        if M.pressed and not dragOwner then
            if hot(ax, ay, aw, ah) then dragOwner = w; w.cmode = "sv"
            elseif hot(ax, hy - 3, aw, 18) then dragOwner = w; w.cmode = "hue"
            elseif hot(ax, ay2 - 3, aw, 18) then dragOwner = w; w.cmode = "alpha" end
        end
        if dragOwner == w and w.cmode then
            if M.down then
                if w.cmode == "sv" then
                    hs[2] = clamp((M.x - ax) / aw, 0, 1)
                    hs[3] = 1 - clamp((M.y - ay) / ah, 0, 1)
                elseif w.cmode == "hue" then
                    hs[1] = clamp((M.x - ax) / aw, 0, 0.999)
                else
                    w.alpha = clamp((M.x - ax) / aw, 0, 1)
                end
                if w.cmode ~= "alpha" then hsv2rgb(hs[1], hs[2], hs[3], col) end
            else
                dragOwner = nil; w.cmode = nil
            end
        end

        Circ(p, "svo", ax + aw * hs[2], ay + ah * (1 - hs[3]), 6, C.black, 1, z + 3, false, 1)
        Circ(p, "svi", ax + aw * hs[2], ay + ah * (1 - hs[3]), 5, C.white, 1, z + 4, false, 1.5)

        -- hue bar
        for i = 0, 23 do
            hsv2rgb((i + 0.5) / 24, 1, 1, TMPC)
            Rect(p, 1000 + i, ax + i * aw / 24, hy, aw / 24 + 0.7, 12, TMPC, 1, z, true, 0)
        end
        Rect(p, "hm", ax + aw * hs[1] - 2, hy - 2, 4, 16, C.white, 1, z + 3, true, 2)
        Rect(p, "hmo", ax + aw * hs[1] - 2, hy - 2, 4, 16, C.black, 1, z + 4, false, 2, 1)

        -- alpha bar
        for i = 0, 19 do
            mixInto(TMPC, C.track, col, (i + 0.5) / 20)
            Rect(p, 2000 + i, ax + i * aw / 20, ay2, aw / 20 + 0.7, 12, TMPC, 1, z, true, 0)
        end
        Rect(p, "am", ax + aw * w.alpha - 2, ay2 - 2, 4, 16, C.white, 1, z + 3, true, 2)
        Rect(p, "amo", ax + aw * w.alpha - 2, ay2 - 2, 4, 16, C.black, 1, z + 4, false, 2, 1)

        -- hex + rgb readouts
        local by = ay2 + 24
        Txt(p, "hxl", "Hex", x + 12, by + 11, C.dim, 1, z, 11.5, true)
        Box2(p, "hxb", x + 48, by, p.w - 60, 22, C.bg, C.border, 1, z, 5)
        local r8, g8, b8, a8 = b255(col[1]), b255(col[2]), b255(col[3]), b255(w.alpha)
        local hexKey = ((r8 * 256 + g8) * 256 + b8) * 256 + a8
        if p.hexKey ~= hexKey then p.hexKey = hexKey; p.hexTxt = string.format("#%02X%02X%02X%02X", r8, g8, b8, a8) end
        Txt(p, "hxt", p.hexTxt,
            x + 58, by + 11, C.text, 1, z + 2, 12, false)
        local ry = by + 30
        Txt(p, "rgl", "RGB", x + 12, ry + 11, C.dim, 1, z, 11.5, true)
        local bw4 = (p.w - 60 - 12) / 4
        for i = 1, 4 do
            local v = (i == 4) and b255(w.alpha) or b255(col[i])
            local bx = x + 48 + (i - 1) * (bw4 + 4)
            Box2(p, kk("rb", i), bx, ry, bw4, 22, C.bg, C.border, 1, z, 5)
            Txt(p, kk("rt", i), kk("", v), bx + bw4 / 2, ry + 11, C.text, 1, z + 2, 11.5, false, "c")
        end

        -- Advanced side panel (Animation + Speed), reuses the normal widgets
        local ex = p.exw
        if ex > 24 then
            local sx0, aw2 = x + p.w + 6, ex - 6
            local save = GA
            GA = GA * clamp((ex - 24) / 120, 0, 1)
            Box2(p, "adv", sx0, y, aw2, 106, C.popup, C.border, 1, z, 8)
            Txt(p, "advt", "Advanced", sx0 + 12, y + 18, C.text, 1, z + 2, 13.5, true)
            Ln(p, "advl", sx0 + 10, y + 36, sx0 + aw2 - 10, y + 36, C.border, 1, z + 2, 1)
            local cy = y + 42
            for _, r in ipairs(w.adv.rows) do
                r:draw(sx0 + 12, cy, aw2 - 24, z + 4)
                cy = cy + r.h
            end
            GA = save
        end
    end

    openSwatchPop = function(w, ax, ay)
        local op = w.inPopup and openChild or openPop
        op("color", { owner = w, x = ax, y = ay, w = 210, content = colorContent, measure = function() return 264 end })
    end
end

local Kinds = {}
for _, k in ipairs({ "switch", "slider", "choice", "multi", "popover", "keypill", "entry", "buttons", "themes", "caption", "chip", "chips", "tabs", "preview", "plist", "notice", "stats" }) do
