end

-- Copies text to the clipboard and shows a toast with the result.
function Lime:Copy(text, title)
    local ok = type(setclipboard) == "function" and pcall(setclipboard, text)
    if ok then self:Toast({ Title = title or "Copied", Text = text, Icon = "check", Duration = 2.5 })
    else self:Toast({ Title = "Could not copy to the clipboard", Icon = "info", Duration = 3 }) end
    return ok and true or false
end

function Lime:Toast(o)
    local t = { title = o.Title or "", text = o.Text or "", icon = o.Icon, born = tick(), total = o.Total, cur = o.Current or 0, pos = o.Pos }
    t.dur = (not o.Total) and (o.Duration or 3) or nil
    function t:Set(v) self.cur = v end
    function t:Close() self.closing = true end
    table.insert(self.toasts, t)
    return t
end

--========================================================================
-- Configs: save / load / delete / autoload and unsaved-change tracking
--========================================================================
-- Files live in the executor workspace: fzzr_index.txt (list of names), fzzr_cfg_<name>.txt, fzzr_autoload.txt
local CFG_INDEX, CFG_AUTO, CFG_PREFIX = "fzzr_index.txt", "fzzr_autoload.txt", "fzzr_cfg_"
local CFG_SKIP = { cfg_name = true, cfg_sel = true, auto_save = true }   -- not part of a config

local function fsOK() return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function" end
local function cfgFile(name) return CFG_PREFIX .. (name:gsub("[^%w%-_%.]", "_")) .. ".txt" end
local function splitBar(s) local t = {} for part in (s or ""):gmatch("[^|]+") do t[#t + 1] = part end return t end
local function numStr(v) return string.format("%.5g", v) end

-- the whole state as text, sorted so equal states give equal text (forCompare skips animated colours)
function Lime:Serialize(forCompare)
    -- the sorted id list only changes when items are added, so it is built once and reused
    local ids = self.sortedIds
    local count = 0
    for _ in pairs(self.items) do count = count + 1 end
    if not ids or self.sortedCount ~= count then
        ids = {}
        for id in pairs(self.items) do if not CFG_SKIP[id] then ids[#ids + 1] = id end end
        table.sort(ids)
        self.sortedIds, self.sortedCount = ids, count
    end
    local out = {}
    for _, id in ipairs(ids) do
        local w = self.items[id]
        local k, v = w.kind, nil
        if k == "switch" or k == "chip" then v = w.value and "1" or "0"
        elseif k == "slider" then v = numStr(w.value)
        elseif k == "choice" or k == "themes" or k == "tabs" or k == "keypill" then v = tostring(w.value)
        elseif k == "multi" then
            local t = {}
            for _, n in ipairs(w.items) do if w.set[n] then t[#t + 1] = n end end
            v = table.concat(t, "|")
        elseif k == "plist" then v = table.concat(w.order, "|")
        elseif k == "entry" then v = (w.text:gsub("[\t\r\n]", " "))
        end
        if v ~= nil then out[#out + 1] = "v:" .. id .. "\t" .. v end
        if k == "switch" then
            if w.color and not (forCompare and w.anim and w.anim > 1) then
                out[#out + 1] = string.format("c:%s\t%.4f,%.4f,%.4f,%.3f", id, w.color[1], w.color[2], w.color[3], w.alpha or 1)
            end
            if w.bindable or #w.binds > 0 then
                local t = {}
                for _, b in ipairs(w.binds) do t[#t + 1] = b.vk .. ":" .. b.mode .. ":" .. (b.show and "1" or "0") end
                out[#out + 1] = "b:" .. id .. "\t" .. table.concat(t, ";")
            end
        end
    end
    return table.concat(out, "\n")
end

function Lime:Apply(text)
    for line in text:gmatch("[^\r\n]+") do
        local key, val = line:match("^([^\t]+)\t?(.*)$")
        local tag, id
        if key then tag, id = key:match("^(%a):(.+)$") end
        local w = id and self.items[id]
        if w and not CFG_SKIP[id] then
            local k = w.kind
            if tag == "v" then
                local n = tonumber(val)
                if k == "switch" or k == "chip" then w:Set(val == "1")
                elseif k == "slider" or k == "keypill" then if n then w:Set(n) end
                elseif k == "choice" then if n and w.items[n] then w:Set(n) end
                elseif k == "themes" then if n and THEMES[n] then w:Set(n) end
                elseif k == "tabs" then if n and w.opts[n] then w:Set(n) end
                elseif k == "multi" then
                    local set = {}
                    for _, nm in ipairs(splitBar(val)) do set[nm] = true end
                    w.set = set
                    if w.callback then w.callback(w.set) end
                elseif k == "plist" then
                    local names = splitBar(val)
                    local have, ok = {}, (#names == #w.order)
                    for _, nm in ipairs(w.order) do have[nm] = true end
                    for _, nm in ipairs(names) do if not have[nm] then ok = false end end
                    if ok then   -- only accept a reordering of the same names
                        for i, nm in ipairs(names) do w.order[i] = nm end
                        if w.callback then w.callback(w.order) end
                    end
                elseif k == "entry" then w.text = val
                end
            elseif tag == "c" and w.color then
                local r, g, b, a = val:match("^([%d%.%-]+),([%d%.%-]+),([%d%.%-]+),([%d%.%-]+)$")
                if r then
                    w.color[1], w.color[2], w.color[3] = tonumber(r), tonumber(g), tonumber(b)
                    w.alpha = tonumber(a)
                    w.hsv = nil
                end
            elseif tag == "b" and k == "switch" then
                local binds = {}
                for item in val:gmatch("[^;]+") do
                    local vk, mode, show = item:match("^(%d+):(%a+):([01])$")
                    if vk then binds[#binds + 1] = { vk = tonumber(vk), mode = mode, show = (show == "1"), last = false } end
                end
                w.binds = binds
            end
        end
    end
end

function Lime:CfgNames()
    local names = {}
    if fsOK() and isfile(CFG_INDEX) then
        local ok, txt = pcall(readfile, CFG_INDEX)
        if ok and type(txt) == "string" then for l in txt:gmatch("[^\r\n]+") do names[#names + 1] = l end end
    end
    return names
end

local function cfgWriteIndex(names) pcall(writefile, CFG_INDEX, table.concat(names, "\n")) end

-- refreshes the "Saved" dropdown in place (its item list is shared with the popup)
function Lime:CfgRefresh(select)
    local it = self.items["cfg_sel"]
    if not it then return end
    local names = self:CfgNames()
    self.cfgList = names
    for i = #it.items, 1, -1 do it.items[i] = nil end
    if #names == 0 then
        it.items[1] = "(none)"; it.value = 1
    else
        for i, n in ipairs(names) do it.items[i] = n end
        local idx = it.value
        if select then for i, n in ipairs(names) do if n == select then idx = i end end end
        it.value = clamp(idx, 1, #names)
    end
end

function Lime:CfgSelected()
    local it = self.items["cfg_sel"]
    return it and self.cfgList and self.cfgList[it.value] or nil
end

function Lime:CfgSave(name)
    if not fsOK() then return false, "File access is not available" end
    name = (name or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then return false, "Enter a config name" end
    local ok = pcall(writefile, cfgFile(name), "FZZR1\n" .. self:Serialize(false))
    if not ok then return false, "Could not write the file" end
    local names, found = self:CfgNames(), false
    for _, n in ipairs(names) do if n == name then found = true end end
    if not found then names[#names + 1] = name; cfgWriteIndex(names) end
    self.cfgName = name
    self.baseline = self:Serialize(true)
    self.dirty = false
    self:CfgRefresh(name)
    return true
end

function Lime:CfgLoad(name)
    if not fsOK() then return false, "File access is not available" end
    if not name or not isfile(cfgFile(name)) then return false, "Config not found" end
    local ok, txt = pcall(readfile, cfgFile(name))
    if not ok or type(txt) ~= "string" or txt:sub(1, 5) ~= "FZZR1" then return false, "Not a valid config" end
    self:Apply(txt)
    self.cfgName = name
    self.baseline = self:Serialize(true)
    self.dirty = false
    return true
end

function Lime:CfgDelete(name)
    if not name then return false, "Nothing selected" end
    local keep = {}
    for _, n in ipairs(self:CfgNames()) do if n ~= name then keep[#keep + 1] = n end end
    cfgWriteIndex(keep)
    local f = cfgFile(name)
    if type(delfile) == "function" then pcall(delfile, f) elseif fsOK() then pcall(writefile, f, "") end
    if self.cfgName == name then self.cfgName = nil end
    self:CfgRefresh()
    return true
end

function Lime:CfgSetAutoload(name)
    if not fsOK() then return false, "File access is not available" end
    if not name then return false, "Nothing selected" end
    pcall(writefile, CFG_AUTO, name)
    return true
end

-- called once after the menu is built: fills the list, applies the autoload config, takes the baseline
function Lime:CfgInit()
    self:CfgRefresh()
    if fsOK() and isfile(CFG_AUTO) then
        local ok, name = pcall(readfile, CFG_AUTO)
        if ok and type(name) == "string" then
            name = name:gsub("[\r\n]", "")
            if name ~= "" and isfile(cfgFile(name)) then
                self:CfgLoad(name)
                self:CfgRefresh(name)
            end
        end
    end
    self.baseline = self:Serialize(true)
    self.dirty = false
end

-- every 0.4s while the menu is open: compare against the saved baseline, and auto save if enabled
function Lime:CfgTick(now)
    self.snapT = (self.snapT or 0) - DT
    if self.snapT > 0 or not self.baseline or not self.open then return end
    self.snapT = 0.4
    local dirty = self:Serialize(true) ~= self.baseline
    if dirty and not self.dirty then self.dirtyAt = now end
    self.dirty = dirty
    if dirty and self.cfgName and self:Get("auto_save") and now - (self.dirtyAt or now) > 1.5 then
        self:CfgSave(self.cfgName)
    end
end

function Lime:Destroy()
    self.dead = true
    if self.conn then self.conn:Disconnect(); self.conn = nil end
    for i = 1, #pool do pcall(function() pool[i].obj:Remove() end) end
    pool, shownList, shownN, KINDN, liveN, deadCount = {}, {}, 0, {}, 0, 0
    if _G.__FzzrHub == self then _G.__FzzrHub = nil end
end

