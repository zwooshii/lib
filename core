local IMG_BASE = "https://raw.githubusercontent.com/zwooshii/lib/main/assets/flaticons/"
local ICONFILE = { crosshair = "Crosshair", brush = "Sword", mountain = "World", blade = "Slash",
    bolt = "Bolt", gear = "Cog", user = "Profile" }
local ICONDATA = {}                              -- file name -> raw PNG bytes (filled by the loader)

local function Pic(o, k, data, cx, cy, s, col, a, z)
    a = (a or 1) * GA
    if a < 0.01 then return end
    if CLIP0 and (cy - s / 2 < CLIP0 or cy + s / 2 > CLIP1) then return end     -- images were the one primitive that ignored the clip
    local d = get(o, k, "Image")
    local c, obj = d.c, d.obj
    if c.data ~= data then c.data = data; obj.Data = data end
    local sz = floor(s + 0.5)
    if c.sz ~= sz then c.sz = sz; obj.Size = Vector2.new(sz, sz) end
    local X, Y = px(cx - s / 2), py(cy - s / 2)
    if c.px ~= X or c.py ~= Y then c.px = X; c.py = Y; obj.Position = Vector2.new(X, Y); WR = WR + 1 end
    setcol(d, col)
    -- the glyphs are light grey, so dim states are also shown through transparency
    set(d, "Transparency", floor(a * (0.4 + 0.6 * min(1, col[1] / 0.9)) * 100 + 0.5) / 100)
    set(d, "ZIndex", z)
    show(d)
end

local function Icon(o, k, name, cx, cy, s, col, a, z)
    local file = ICONFILE[name]
    local data = file and ICONDATA[file]
    if data then Pic(o, k .. "img", data, cx, cy, s + 2, col, a, z); return end
    local h = s / 2
    if name == "crosshair" then
        Circ(o, k .. "1", cx, cy, h - 1, col, a, z, false, 1.5)
        Circ(o, k .. "2", cx, cy, 1.5, col, a, z, true)
    elseif name == "brush" then
        Ln(o, k .. "1", cx - h + 2, cy + h - 2, cx + h - 2, cy - h + 2, col, a, z, 2.6)
        Circ(o, k .. "2", cx - h + 2, cy + h - 2, 2.2, col, a, z, true)
    elseif name == "mountain" then
        Tri(o, k .. "1", cx - h, cy + h - 2, cx - 1, cy - h + 2, cx + h - 4, cy + h - 2, col, a, z)
        Tri(o, k .. "2", cx - 1, cy + h - 2, cx + 3, cy - 2, cx + h + 1, cy + h - 2, col, a, z)
    elseif name == "blade" then
        Ln(o, k .. "1", cx - h + 2, cy + h - 2, cx + h - 2, cy - h + 2, col, a, z, 2.4)
