    elseif name == "bolt" then
        Ln(o, k .. "1", cx + 2, cy - h + 1, cx - 3, cy + 1, col, a, z, 2.2)
        Ln(o, k .. "2", cx - 3, cy + 1, cx + 2, cy + 1, col, a, z, 2.2)
        Ln(o, k .. "3", cx + 2, cy + 1, cx - 2, cy + h - 1, col, a, z, 2.2)
    elseif name == "gear" then
        Circ(o, k .. "1", cx, cy, h - 3, col, a, z, false, 2.2)
