    for i = -1, 1 do Circ(w, kk("d", i), dx + 12 + i * 4.5, y + ch / 2, 1.4, dcol, 1, z + 3, true) end
    if dh and M.pressed then openSubPop(w, dx + 24 - w.pw, y + ch + 4) end
end
function Kinds.chips.draw(w, x, y, wd, z)
    local cw = (wd - 8) / 2
    for i, c in ipairs(w.list) do
