-- ESP preview panel (reads the esp_* chip states live) ------------------------
local YEL = { 1, 0.78, 0.2 }
function Kinds.preview.draw(w, x, y, wd, z)
    local hub = w.hub
    local ph = w.h - 6
    Box2(w, "bg", x, y, wd, ph, C.bg, C.border, 1, z, 6)
    for i = 1, floor(wd / 22) do Ln(w, kk("gv", i), x + i * 22, y + 2, x + i * 22, y + ph - 2, C.border, 0.35, z + 2, 1) end
    for i = 1, floor(ph / 22) do Ln(w, kk("gh", i), x + 2, y + i * 22, x + wd - 2, y + i * 22, C.border, 0.35, z + 2, 1) end
    local cx = x + wd / 2
    local rot = 0
    if hub:Get("pv_rotate") then rot = tick() * (hub:Get("pv_speed") or 50) * math.pi / 180 end
    local f = 0.4 + 0.6 * abs(math.cos(rot))
    local lit = hub:Get("esp_vischams") or hub:Get("esp_glow") or hub:Get("esp_highlight")
    local tint = lit and C.accent or C.dim
    local bt, bb = y + 34, y + 160
    Circ(w, "hd", cx, bt + 18, 12, tint, 1, z + 4, true)
    Rect(w, "tr", cx - 20 * f, bt + 32, 40 * f, 52, tint, 1, z + 4, true, 6)
    Rect(w, "l1", cx - 17 * f, bt + 84, 15 * f, 42, tint, 1, z + 4, true, 4)
    Rect(w, "l2", cx + 2 * f, bt + 84, 15 * f, 42, tint, 1, z + 4, true, 4)
    local bx0, bw = cx - 36, 72
    if hub:Get("esp_box") then Rect(w, "bx", bx0, bt, bw, bb - bt, C.text, 1, z + 6, false, 0, 1) end
    if hub:Get("esp_hpbar") then Rect(w, "hb", bx0 - 6, bt + 30, 3, bb - bt - 30, YEL, 1, z + 6, true, 0) end
    if hub:Get("esp_hptext") then Txt(w, "hp", "51", bx0 - 9, bt + 28, YEL, 1, z + 6, 10, true, "r") end
    if hub:Get("esp_name") then Txt(w, "nm", hub.title, cx, bt - 9, C.text, 1, z + 6, 11, true, "c") end
    if hub:Get("esp_weapon") then Txt(w, "wp", "AK47", cx, bb + 10, C.text, 1, z + 6, 11, true, "c") end
    if hub:Get("esp_flags") then
        Txt(w, "f1", "RELOAD", bx0 + bw + 4, bt + 6, YEL, 1, z + 6, 9.5, true)
        Txt(w, "f2", "HK", bx0 + bw + 4, bt + 17, C.text, 1, z + 6, 9.5, true)
    end
    if hub:Get("esp_arrows") then
        Tri(w, "ar", x + wd - 22, y + ph - 22, x + wd - 10, y + ph - 22, x + wd - 16, y + ph - 10, C.accent, 1, z + 6)
    end
end

-- Chips (toggle pills with a "..." options popup) -----------------------------
function Kinds.chip.Get(w) return w.value end
function Kinds.chip.Set(w, v) w.value = v and true or false; if w.callback then w.callback(w.value) end end
function Kinds.chip.draw(w, x, y, cw, z)
    local ch = 24
    local hv = hot(x, y, cw - 26, ch)
    local ha = ani(w, "h", hv and 1 or 0, 14)
    local oa = ani(w, "o", w.value and 1 or 0, 14)
    local fill = mix(mix(C.group, C.text, 0.06 + 0.05 * ha), C.accent, oa)
    Box2(w, "bx", x, y, cw, ch, fill, mix(C.border, C.accent, max(oa, ha * 0.6)), 1, z, 8)
    local tcol = mix(mix(C.dim, C.text, max(ha, 0.55)), C.onacc, oa)
    Txt(w, "t", fit(w.label, cw - 40, 12), x + 10, y + ch / 2, tcol, 1, z + 3, 12, true)
    if hv and M.pressed then w:Set(not w.value) end
    local dx = x + cw - 24
