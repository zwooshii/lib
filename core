-- mix() returns a table from a ring buffer instead of allocating one: every caller consumes the
-- result immediately (setcol copies the numbers), so reuse is safe and creates no garbage.
local MIXN, MIXI = 1024, 0
local MIXR = {}
for i = 1, MIXN do MIXR[i] = { 0, 0, 0 } end
local function mix(a, b, t)
    MIXI = MIXI % MIXN + 1
    local r, a1, a2, a3 = MIXR[MIXI], a[1], a[2], a[3]
    r[1] = a1 + (b[1] - a1) * t
    r[2] = a2 + (b[2] - a2) * t
    r[3] = a3 + (b[3] - a3) * t
    return r
end
local function mixInto(r, a, b, t)
    local a1, a2, a3 = a[1], a[2], a[3]
    r[1] = a1 + (b[1] - a1) * t
    r[2] = a2 + (b[2] - a2) * t
    r[3] = a3 + (b[3] - a3) * t
end

local NARROW = {}
for ch in (" ijltfrI.,:;|!'[]()"):gmatch(".") do NARROW[ch] = true end
-- per-byte width table (same widths as before, one lookup per character instead of sub + byte + compares)
local WTAB = {}
for b = 0, 255 do
    local ch = string.char(b)
    if NARROW[ch] then WTAB[b] = 0.33
    elseif ch == "m" or ch == "w" or ch == "M" or ch == "W" then WTAB[b] = 0.86
    elseif b >= 65 and b <= 90 then WTAB[b] = 0.64
    elseif b >= 128 then WTAB[b] = 0.3
    else WTAB[b] = 0.56 end
end
-- tw / fit are memoised per (size, string): the same labels are measured every frame. The caches are bounded.
local TWC, TWN = {}, 0
local function tw(s, size)
    local bySize = TWC[size]
    if not bySize then bySize = {}; TWC[size] = bySize end
    local v = bySize[s]
    if v then return v end
    local w = 0
    for i = 1, #s do w = w + WTAB[s:byte(i)] end
    v = w * size
    TWN = TWN + 1
    if TWN > 600 then TWC, TWN = {}, 0; bySize = {}; TWC[size] = bySize end
    bySize[s] = v
    return v
end
local FITC, FITN = {}, 0
local function fit(s, maxw, size)
    local a = FITC[maxw]
    if not a then a = {}; FITC[maxw] = a end
    local b = a[size]
    if not b then b = {}; a[size] = b end
    local hit = b[s]
    if hit then return hit end
    local out = s
    if tw(s, size) > maxw then
        local cut = s
        while #cut > 1 and tw(cut .. "...", size) > maxw do cut = cut:sub(1, #cut - 1) end
        out = cut .. "..."
    end
    FITN = FITN + 1
    if FITN > 400 then FITC, FITN = {}, 0; a = {}; FITC[maxw] = a; b = {}; a[size] = b end
    b[s] = out
    return out
end
-- cached "<prefix><number>" draw keys (building them with .. every frame converts the number each time)
local KCACHE = {}
local function kk(p, i)
    local a = KCACHE[p]
    if not a then a = {}; KCACHE[p] = a end
    local s = a[i]
    if not s then s = p .. i; a[i] = s end
    return s
end
local function wrap(text, maxw, size)
    local lines, line = {}, ""
    for word in text:gmatch("%S+") do
        local t = (line == "") and word or (line .. " " .. word)
        if tw(t, size) > maxw and line ~= "" then lines[#lines + 1] = line; line = word else line = t end
    end
    if line ~= "" then lines[#lines + 1] = line end
    return lines
end

