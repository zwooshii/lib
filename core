for i = 0x30, 0x39 do KN[i] = string.char(i) end
for i = 0x41, 0x5A do KN[i] = string.char(i) end
for i = 1, 12 do KN[0x6F + i] = "F" .. i end
for i = 0, 9 do KN[0x60 + i] = "Num" .. i end
local function keyName(vk) if not vk or vk == 0 then return "None" end return KN[vk] or ("K" .. vk) end

local TYPEVK = {}
for vk = 0x30, 0x39 do TYPEVK[#TYPEVK + 1] = vk end
for vk = 0x41, 0x5A do TYPEVK[#TYPEVK + 1] = vk end
TYPEVK[#TYPEVK + 1] = 0x20; TYPEVK[#TYPEVK + 1] = 0xBD; TYPEVK[#TYPEVK + 1] = 0xBE
local function vkChar(vk, shift)
    if vk >= 0x41 and vk <= 0x5A then local ch = string.char(vk); return shift and ch or ch:lower() end
    if vk >= 0x30 and vk <= 0x39 then return string.char(vk) end
    if vk == 0x20 then return " " end
    if vk == 0xBD then return shift and "_" or "-" end
    if vk == 0xBE then return "." end
end

local function startCapture(owner, setfn) CAP = { owner = owner, set = setfn }; primeKeys() end
local function focusText(o) TI.owner = o; TI.bs = 0; primeKeys() end

